[0.736, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[7Aseed\u001b[1Clist\u001b[1C∪\u001b[1C(SELECT\u001b[1CDISTINCT\u001b[1Ccategory\u001b[1CFROM\u001b[1Creceipt_items)\r\u001b[2C\u001b[1B    \u001b[1C    \u001b[1C \u001b[1C       \u001b[1C        \u001b[1C        \u001b[1C    \u001b[1C              \r\u001b[2C\u001b[1BThe\u001b[1C\u001b[38;2;87;105;247mcategories\u001b[1C\u001b[39mtable\u001b[1Cthen\u001b[1Cexists\u001b[1Cprimarily\u001b[1Cas\u001b[1Ca\u001b[1Csoft-delete\u001b[1C/\u001b[1Chide-list\u001b[1C(\u001b[38;2;87;105;247mactive=0\u001b[39m)\u001b[1Cplus\u001b[1Ca\u001b[1Cplace\u001b[1Cto\u001b[1Chang\u001b[1Cthe\u001b[1Cseeds.\u001b[1CNo\r\u001b[1B  ref-counting bookkeeping, no drift between table and items. The CRUD endpoints mostly write to the hide list.         \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r"]
