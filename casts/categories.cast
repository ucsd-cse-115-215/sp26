[0.037, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1m2. \"Select existing\" vs \"Create new\" should be explicit in the API, not inferred.\u001b[22m If the UI just PUTs \u001b[38;2;87;105;247mcategory: \u001b[39m      \r\u001b[1B  \u001b[38;2;87;105;247m\"dining\"\u001b[39m,\u001b[1Cthe\u001b[1Cserver\u001b[1Chas\u001b[1Cto\u001b[1Cguess:\u001b[1Cdid\u001b[1Cthey\u001b[1Cmean\u001b[1Cto\u001b[1Cpick\u001b[1C\u001b[38;2;87;105;247mDining\u001b[1C\u001b[39m(case-mismatch)\u001b[1Cor\u001b[1Cactually\u001b[1Ccreate\u001b[1Ca\u001b[1Cnew\u001b[1C\u001b[38;2;87;105;247mdining\u001b[39m?\u001b[1CSince\r\u001b[1B   the combobox already distinguishes these two clicks, encode it: either separate endpoints, or pass \u001b[38;2;87;105;247m{category: \u001b[39m       \r\u001b[2C\u001b[1B\u001b[38;2;87;105;247m\"Dining\"}\u001b[39m for\u001b[1Cselection\u001b[1Cvs\u001b[1Can\u001b[1Cexplicit\u001b[1Ccreate\u001b[1Ccall\u001b[1Cfirst.\u001b[1COtherwise\u001b[1Cyou've\u001b[1Crebuilt\u001b[1Cthe\u001b[1C\"typos\u001b[1Cleak in\" problem from \r\r\n\u001b[2Coption\u001b[1C#1.\r\r\n\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────"]
