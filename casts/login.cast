[0.689, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[1mAbandoned ceremony.\u001b[22m User hits /options, closes the tab before completing verify. Row sits with \u001b[38;2;87;105;247muser_id = NULL\u001b[39m until \r\u001b[1B  \u001b[38;2;87;105;247mexpires_at\u001b[1C\u001b[39mpasses\u001b[1Cand\u001b[1C\u001b[38;2;87;105;247mpruneExpiredSessions\u001b[1C\u001b[39mdeletes\u001b[1Cit.\u001b[1CNo\u001b[1Charm\u001b[1Cdone.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────"]
