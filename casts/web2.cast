[0.823, "o", "\u001b[32;1H  It does the same thing as the scan endpoint after parsing: takes a \u001b[38;5;105mParsedReceipt\u001b[39m, runs \u001b[38;5;105minsertReceipt\u001b[39m (which converts to cents),   \u001b[33;1H  returns\u001b[Cthe\u001b[Cstored\u001b[Cresult.\u001b[CJust\u001b[Cskips\u001b[Cthe\u001b[Cimage\u001b[Cupload\u001b[Cand\u001b[CAI\u001b[Ccall.\r\n                                                                                                                                    \u001b[35;1H\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[36;1H\u001b(B\u001b[m\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[36;132H\n\u001b[35;3H\u001b[7m \u001b(B\u001b[m\r\n\u001b[K\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
