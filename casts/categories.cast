[0.297, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A3.\u001b[1C\u001b[1mEvery read becomes a JOIN.\u001b[1C\u001b[22m\u001b[38;2;87;105;247mattachItems\u001b[1C\u001b[39m(\u001b[38;2;87;105;247msrc/server/db.ts:14\u001b[39m),\u001b[1Cthe\u001b[1CAPI\u001b[1Cresponse\u001b[1Cshape,\u001b[1Cthe\u001b[1Ceval\u001b[1Charness\u001b[1Ccomparisons\r\u001b[1B  — all get more complex. Small cost, but pure overhead at your scale.                                                  \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
