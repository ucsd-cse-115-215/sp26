[0.020, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[12A-\u001b[1CThe\u001b[1Ccategory\u001b[1Ccell\u001b[1Cis\u001b[1Cnow\u001b[1Ca\u001b[1Cread-only\u001b[1Cinput\u001b[1Cshowing\u001b[1Cthe\u001b[1Ccurrent\u001b[1Cvalue\u001b[1C—\u001b[1Cno\u001b[1Clonger\u001b[1Ceditable\u001b[1Cin\u001b[1Cplace.\r\u001b[4C\u001b[1BClicking it op\u001b[1Cns\u001b[1Ca popup below with\u001b[1Ca blank search field at \u001b[1Che top. Typing ther\u001b[1C filters; empty search\u001b[1Cshows\u001b[1Cthe\r\u001b[2C\u001b[1Bful\u001b[1C list.\u001b[1C  \u001b[1C     \u001b[1C \u001b[1C     \u001b[1C     \u001b[1C    \u001b[1C \u001b[1C     \u001b[1C      \u001b[1C     \u001b[1C  \u001b[1C   \u001b[1C    \u001b[1C      \u001b[1C     \u001b[1C        \u001b[1C     \u001b[1C      \u001b[1C     \u001b[1C   \r\u001b[2C\u001b[1B- \u001b[38;2;87;105;247m+ Create \"...\"\u001b[1C\u001b[39mappears\u001b[1Cin\u001b[1Cthe\u001b[1Cpopup\u001b[1C(not\u001b[1Cin\u001b[1Cthe\u001b[1Ccell)\u001b[1Cwhen\u001b[1Cthe\u001b[1Csearch\u001b[1Cdoesn't\u001b[1Cexact-match.\r\u001b[4C\u001b[1BCloses on outside click, Escape, or\u001b[1Cafter commit.    \u001b[1C    \u001b[1C   \u001b[1C      \u001b[1C       \u001b[1C            \r\u001b[4C\u001b[1BB\u001b[1Cur behavior \u001b[1Cs gone — there's n\u001b[1Cthing to blur commit\u001b[1Cagainst,\u001b[1Cwhich\u001b[1Cmatches\u001b[1Cwhat\u001b[1Cyou\u001b[1Cwanted.\r\u001b[2C\u001b[1B \u001b[1C    \u001b[1C        \u001b[1C  \u001b[1C    \u001b[1C \u001b[1C       \u001b[1C       \u001b[1C  \u001b[1C    \u001b[1C      \u001b["]
