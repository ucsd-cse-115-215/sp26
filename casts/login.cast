[0.592, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The mental model to keep: the authenticator is wherever the private key is \u001b[3mand\u001b[23m whatever code can sign with it. It's   \r\u001b[1B  not\u001b[1Ca\u001b[1Cbrowser\u001b[1Cthing.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
