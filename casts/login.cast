[0.296, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Existing tests get a tiny diff — one helper call in \u001b[38;2;87;105;247mbefore\u001b[39m, and every \u001b[38;2;87;105;247mfetch\u001b[39m call gains \u001b[38;2;87;105;247mheaders: { Cookie }\u001b[39m. Then I'll \r\u001b[1B  add\u001b[1Cone\u001b[1Cregister-then-login\u001b[1Cround-trip\u001b[1Ctest\u001b[1Cusing\u001b[1CSimpleWebAuthn's\u001b[1Ctest\u001b[1Chelpers\u001b[1C(which\u001b[1Ccan\u001b[1Cmock\u001b[1Can\u001b[1Cauthenticator's\r\u001b[1B  signing behavior).                                                                                                    \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────"]
