[0.817, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mOn 4:\u001b[22m \"Unassigned\" as an undeletable sentinel works. Cheap to implement — \u001b[38;2;87;105;247mactive=1, deletable=0\u001b[39m column or just a      \r\u001b[1B  hardcoded\u001b[1Cname\u001b[1Ccheck.\u001b[1CDelete\u001b[1Cendpoint\u001b[1Creassigns\u001b[1Citems\u001b[1C→\u001b[1C\"Unassigned\"\u001b[1Cand\u001b[1Csoft-deletes\u001b[1Cthe\u001b[1Ccategory.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────"]
