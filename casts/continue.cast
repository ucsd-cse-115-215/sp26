[0.002, "o", "\u001b[32;1H\u001b[38;5;248m\u001b[48;5;255m\u276f \u001b[38;5;16mSince this is a web-based project let's keep things in \u001b[39m   \r\n  \u001b[38;5;16mone language. I would like to use TypeScript. I can put a\u001b[39m \r\n  \u001b[38;5;16m key in .env\u001b[39m                                              \u001b[35;3H\u001b[49m \u001b[C   \u001b[C  \u001b[C     \r\n\u001b[38;5;174m\u273b\u001b[39m \u001b[38;5;174mFroli\u001b(B\u001b[m\u001b[38;5;216mcki\u001b(B\u001b[m\u001b[38;5;174mng\u2026 \u001b[39m                                              \r\n\u001b[38;5;241m  \u23bf \u00a0Tip: Use ctrl+v to paste images from your clipboard\u001b[39;1H\u001b(B\u001b[m\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\u001b(B\u001b[m\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[1;40r\u001b[1;60s\u001b[40;60H\n\u001b[1;40r\u001b[s\u001b[39;3H\u001b[7m \u001b(B\u001b[m\u001b[40;60H\u001b[1K\r\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[1;40r\u001b[1;60s\u001b[1;1H\u001b[2S\u001b[39;2H\u001b[1K"]
