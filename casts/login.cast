[0.656, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Per your decisions, \u001b[38;2;87;105;247mcredentials\u001b[39m has \u001b[1mfour\u001b[22m columns of data (\u001b[38;2;87;105;247muser_id\u001b[39m, \u001b[38;2;87;105;247mcredential_id\u001b[39m, \u001b[38;2;87;105;247mpublic_key\u001b[39m, \u001b[38;2;87;105;247mcreated_at\u001b[39m) — no        \r\u001b[1B  \u001b[38;2;87;105;247mcounter\u001b[39m,\u001b[1Cno\u001b[1C\u001b[38;2;87;105;247mtransports\u001b[39m,\u001b[1Cno\u001b[1C\u001b[38;2;87;105;247mbacked_up\u001b[39m,\u001b[1Cno\u001b[1C\u001b[38;2;87;105;247mlast_used_at\u001b[39m.\u001b[1CThat's\u001b[1Cas\u001b[1Clean\u001b[1Cas\u001b[1Cthe\u001b[1Cprotocol\u001b[1Callows.\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1B\u001b[1mPlanned update to \u001b[38;2;87;105;247msrc/server/db.ts\u001b[65C\u001b[22m\u001b[39m                 \r\r\n\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────────────────────────"]
