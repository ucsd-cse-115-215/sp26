[0.295, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  1. \u001b[1mUsernameless (discoverable) login?\u001b[22m Modern passkeys support \"resident keys\" where the browser shows a list of       \r\u001b[1B  passkeys\u001b[1Cfor\u001b[1Cyour\u001b[1Csite\u001b[1Cand\u001b[1Cthe\u001b[1Cuser\u001b[1Cpicks\u001b[1Cone\u001b[1C—\u001b[1Cno\u001b[1Cusername\u001b[1Cfield\u001b[1Cat\u001b[1Call.\u001b[1CMaximally\u001b[1Cminimal,\u001b[1Cbut\u001b[1Cthe\u001b[1CUX\u001b[1Cis\u001b[1Cless\r\u001b[1B  familiar. Alternative: require a username on register, use it to look up credentials on login.                        \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────"]
