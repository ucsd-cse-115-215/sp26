[0.797, "o", "\u001b[3AThe\u001b[C\u001b[38;5;105mRequest\u001b[C\u001b[39mgeneric\u001b[Cis\u001b[C\u001b[38;5;105mRequest<Params, ResBody, ReqBody>\u001b[39m.\u001b[CThe\u001b[Csecond\u001b[Cparameter\u001b[C\u001b[38;5;105mResBody\u001b[C\u001b[39misn't\u001b[Cabout\u001b[Cthe\u001b[Crequest\u001b[Cat\u001b[Call\u001b[C\u2014\u001b[Cit's\u001b[31;3HExpress\u001b[Cleaking\u001b[Cthe\u001b[Cresponse\u001b[Cbody\u001b[Ctype\u001b[Cinto\u001b[Cthe\u001b[CRequest\u001b[Ctype.\u001b[CIt\u001b[Cexists\u001b[Cbecause\u001b[CExpress\u001b[Cinternally\u001b[Cties\u001b[CRequest\u001b[Cand\u001b[CResponse\r\n  together.                                                                                                                         \u001b[33;1H   \u001b[35;1H\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[7m \u001b(B\u001b[m           \r\n\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m"]
