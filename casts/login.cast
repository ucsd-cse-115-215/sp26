[0.957, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1muserVerification: \"preferred\"\u001b[39m.\u001b[1C\u001b[22mDon't\u001b[1Cdemand\u001b[1Cbiometric\u001b[1Con\u001b[1Cevery\u001b[1Clogin\u001b[1C(would\u001b[1Cfail\u001b[1Con\u001b[1CUSB\u001b[1Ckeys\u001b[1Cwithout\u001b[1CPIN),\u001b[1Cbut\r\u001b[1B  accept it when offered. Matches the \"this is a personal app\" posture.                                                 \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
