[0.954, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  This is mostly #1 with the cookie swap made explicit, which can prevent a subtle bug where a leftover pending-session \r\u001b[1B  cookie\u001b[1Csomehow\u001b[1Cgets\u001b[1Ctreated\u001b[1Cas\u001b[1Cauthenticated.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────────"]
