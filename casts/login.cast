[0.309, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[53C\u001b[13A┬\u001b[1C─\u001b[37C┬\u001b[4C─\r\u001b[53C\u001b[1B│\u001b[1C Cross-\u001b[1Cite subresource (POST form,   │\u001b[2CSame-site requ\u001b[1Csts\r\u001b[24C\u001b[1B(clicking a link) \u001b[11C│\u001b[1C \u001b[8Cfetch, iframe, img)   \u001b[7C│\u001b[4C \u001b[4C        \r\u001b[53C\u001b[1B┼\u001b[1C─\u001b[37C┼\u001b[4C─\r\u001b[53C\u001b[1B│\u001b[1Ccookie ❌  \u001b[27C│\u001b[1Ccookie ✅  \u001b[1C  \r\u001b[53C\u001b[1B┼\u001b[1C─\u001b[37C┼\u001b[4C─\r\u001b[53C\u001b[1B│\u001b[1Ccookie ❌  \u001b[27C│\u001b[1Ccookie ✅  \u001b[1C  \r\u001b[2C\u001b[1B├\u001b[8C┼\u001b[41C┼\u001b[1C─\u001b[37C┼\u001b[4C─\u001b[17C┤\r\u001b[2C\u001b[1B│\u001b[1C\u001b[1mNone\u001b[3C\u001b[22m│\u001b[1Ccookie\u001b[1C✅\u001b[31C│\u001b[1Ccookie\u001b[1C✅\u001b[29C│\u001b[1Ccookie\u001b[1C✅\u001b[1C(requires\u001b[2C│\r\u001b[1B  │        │                                         │                                       │ \u001b[38;2;87;105;247mSecure\u001b[39m)              │   \r\u001b[1B  └────────┴─────────────────────────────────────────┴───────────────────────────────────"]
