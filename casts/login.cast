[0.151, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[7A-\u001b[1CYou\u001b[1Ccan't\u001b[1Caccidentally\u001b[1Cinsert\u001b[1Ca\u001b[1Crow\u001b[1Cwith\u001b[1C\u001b[38;2;87;105;247muser_id IS NULL AND challenge IS NULL\u001b[1C\u001b[39m(a\u001b[1Cmeaningless\u001b[1Cghost\u001b[1Csession).\r\u001b[4C\u001b[1BQueries \u001b[1Ch\u001b[1Ct care on\u001b[3Cabout authenticated rows can say \u001b[38;2;87;105;247mWHERE stat\u001b[1C = 'authenticated'\u001b[39m — more self-documenting\u001b[1Cthan\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mWHERE user_id IS NOT NULL\u001b[39m.\r\u001b[1B                                                                                                                        \r\u001b[1B  Cons:\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1B- Slightly more\u001b[1Cverbose\u001b[1Con\u001b[1Cevery\u001b[1Cwrite.\r\r\n\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────────────────"]
