[0.645, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  1. \u001b[1mTwo new nullable columns on \u001b[38;2;87;105;247msessions\u001b[22m\u001b[39m: \u001b[38;2;87;105;247mpending_user_handle BLOB\u001b[39m, \u001b[38;2;87;105;247mpending_display_name TEXT\u001b[39m. Simple, consistent with \r\u001b[1B  the\u001b[1Csessions-as-one-table\u001b[1Cdecision.\u001b[1CAdds\u001b[1Ctwo\u001b[1Cmore\u001b[1Cbits\u001b[1Cof\u001b[1Cimplicit\u001b[1Cmid-auth\u001b[1Cstate\u001b[1C—\u001b[1Cwhich\u001b[1Cis\u001b[1Calready\u001b[1Cin\u001b[1Cthe\r\u001b[1B  production-readiness list, so it reinforces that tradeoff.                                                            \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────"]
