[0.705, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mSoftware / virtual\u001b[22m:\u001b[1C1Password,\u001b[1CBitwarden,\u001b[1CDashlane\u001b[1Cacting\u001b[1Cas\u001b[1Cauthenticators\u001b[1Cvia\u001b[1Cthe\u001b[1Cbrowser's\u001b[1Cpasskey\u001b[1Cprovider\u001b[1CAPIs.\r\u001b[1B   This is the only case where a browser extension is involved, and even then the extension is \u001b[3mpresenting as\u001b[23m an         \r\u001b[1B  authenticator\u001b[1Cto\u001b[1Cthe\u001b[1Cbrowser\u001b[1C—\u001b[1Cit's\u001b[1Cnot\u001b[1Cwhere\u001b[1Cthe\u001b[1Cauthenticator\u001b[1Clogic\u001b[1Clives\u001b[1Cin\u001b[1Cthe\u001b[1Cabstract\u001b[1Cmodel.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b"]
[0.000, "o", "[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
