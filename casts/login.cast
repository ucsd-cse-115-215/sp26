[0.297, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1mcounter\u001b[1C\u001b[22m\u001b[39m—\u001b[1Ca\u001b[1Cmonotonic\u001b[1Ccounter\u001b[1Cthe\u001b[1Cauthenticator\u001b[1Cincrements\u001b[1Con\u001b[1Ceach\u001b[1Cuse.\u001b[1COn\u001b[1Cevery\u001b[1Clogin,\u001b[1Cthe\u001b[1Clibrary\u001b[1Cchecks\u001b[1Cthat\u001b[1Cthe\r\u001b[1B  incoming counter is \u001b[1mstrictly greater\u001b[22m than what you have stored, then you update it. This is the spec's                \r\u001b[1B  cloned-authenticator\u001b[1Cdetection:\u001b[1Cif\u001b[1Csomeone\u001b[1Cextracts\u001b[1Cthe\u001b[1Cprivate\u001b[1Ckey\u001b[1Cand\u001b[1Cuses\u001b[1Cit\u001b[1Celsewhere,\u001b[1Cthe\u001b[1Ccounters\u001b[1Con\u001b[1Cthe\u001b[1Ctwo\r\u001b[1B  copies will diverge and one will eventually send a counter ≤ stored, which you reject. Caveat: many modern passkeys   \r\u001b[2C\u001b[1B(iCloud Keychain,\u001b[1CGoogle\u001b[1CPassword\u001b[1CManager)\u001b[1Csync\u001b[1Cacross\u001b[1Cdevices\u001b[1Cand\u001b[1Calways\u001b[1Creport\u001b[1C0\u001b[1C—\u001b[1Cin\u001b[1Cthat\u001b[1Ccase the check is a    \r\r\n\u001b[2Cno-op,\u001b[1Cwhich\u001b[1Cis\u001b[1Cfine\u001b[1Cand\u001b[1Cexpected.\r\r\n\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
