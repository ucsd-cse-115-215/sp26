[0.469, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[1mPlatform / built-in\u001b[22m: Secure Enclave on Apple devices, TPM + Windows Hello on Windows, Android Keystore, Linux's     \r\u001b[1B  \u001b[38;2;87;105;247mlibfido2\u001b[1C\u001b[39m+\u001b[1CTPM\u001b[1Csetups.\u001b[1CThese\u001b[1Care\u001b[1COS-level,\u001b[1Csitting\u001b[1Cwell\u001b[1Cbelow\u001b[1Cthe\u001b[1Cbrowser.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────"]
