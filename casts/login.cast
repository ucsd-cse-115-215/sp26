[0.000, "o", "────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.445, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1CThe\u001b[1Ccookie\u001b[1Chas\u001b[1Cto\u001b[1Cexist\u001b[1C\u001b[3mbefore\u001b[1C\u001b[23mthe\u001b[1Cuser\u001b[1Chas\u001b[1Cproven\u001b[1Cidentity,\u001b[1Csince\u001b[1Cthe\u001b[1Cchallenge\u001b[1Cis\u001b[1Cprecisely\u001b[1Cwhat\u001b[1Cproves\u001b[1Cidentity.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                                                                                                                     \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────"]
