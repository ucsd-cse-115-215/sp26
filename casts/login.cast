[0.322, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A4.\u001b[1CThe\u001b[1Csession\u001b[1Chas\u001b[1Cbeen\u001b[1Cassociated\u001b[1Cwith\u001b[1Ca\u001b[1Cuser\u001b[1C(\u001b[38;2;87;105;247muser_id IS NOT NULL\u001b[39m).\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                                                                                                                     \r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────"]
