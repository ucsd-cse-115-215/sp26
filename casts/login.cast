[0.326, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5Astate\u001b[10CTEXT\u001b[1C\u001b[34mNOT\u001b[1CNULL\u001b[1CCHECK\u001b[1C\u001b[39m(state\u001b[1C\u001b[34mIN\u001b[1C\u001b[39m(\u001b[31m'pending'\u001b[39m,\u001b[1C\u001b[31m'authenticated'\u001b[39m)),\r\u001b[1B    user_id        \u001b[36m\u001b[2mINTEGER\u001b[22m\u001b[39m \u001b[34mREFERENCES\u001b[39m users(id),                                                                        \r\u001b[1B   \u001b[1Cchallenge\u001b[6CTEXT,\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────"]
