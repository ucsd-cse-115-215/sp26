[0.275, "o", "\u001b[?2026h\u001b[?2026l"]
[0.004, "o", "\u001b[6;1H\u001b[38;5;248m\u001b[48;5;255m\u276f \u001b[38;5;16mOK, next I want to move on to the backend where we store receipts, and a simple associated front-end to upload and render them.\u001b[39m   \u001b[7;1H                                                                                                                                    \u001b[8;1H  \u001b[38;5;16mThis means we need to talk about storage and about front-end tech.\u001b[39m                                                                \u001b[9;1H                                                                                                                                    \u001b[10;1H  \u001b[38;5;16mFor storage I suspect we can get very far with sqlite. I would like to try and avoid saving the receipt images at all, and just \u001b[39m  \u001b[11;1H  \u001b[38;5;16mstoring extracted and user-corrected data.\u001b[39m                                                                                        \u001b[12;1H                                                                                               \u001b(B\u001b[m"]
[0.0, "o", "\u001b[48;5;255m                                     \u001b[13;1H  \u001b[38;5;16mFor the front-end I've done some React programming before, so I'd like to work with that.\u001b[39m                                         \u001b[14;1H                                                                                                                                    \u001b[15;1H  \u001b[38;5;16mI think we shoudl discuss:\u001b[39m                                                                                                        \u001b[16;1H                                                                                                                                    \u001b[17;1H  \u001b[38;5;16m- The schema for storage of receipts\u001b[39m                                                                                              \u001b[18;1H  \u001b[38;5;16m- The API endpoints for sending requests to the server and what they need to have\u001b[39m                                                 \u001b[19;1H  \u001b[38;5;16m- The pages and content of the pages, and interactions on the p"]
[0.0, "o", "ages\u001b[39m                \u001b(B\u001b[m\u001b[48;5;255m                                               \u001b[20;1H                                                                                                                                    \u001b[21;1H  \u001b[38;5;16mConsult the design document to see what else we've thought through for this, and let's update the design and think through what \u001b[39m  \u001b[22;1H  \u001b[38;5;16mto do first.\u001b[39m                                                                                                                      \u001b[23;3H\u001b[49m  \u001b[C  \u001b[C       \r\n\u001b[38;5;174m\u00b7\u001b[39m \u001b[38;5;174mScampering\u2026 \u001b[39m                                                                                                                      \u001b[25;3H            \r\n\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[0.0, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[27;1H\u001b(B\u001b[m\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[7m \r\n\u001b(B\u001b[m\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[29;3H\u001b(B\u001b[m\u001b[38;5;241m--\u001b[CINSERT\u001b[C--\u001b[27;3H\u001b(B\u001b[m"]
