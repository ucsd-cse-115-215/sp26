[0.053, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[7A\u001b[38;2;245;149;117mn\u001b[39m\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
