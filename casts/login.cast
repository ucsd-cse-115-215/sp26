[0.444, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A2.\u001b[1C\u001b[1mThe library returns the new counter to you\u001b[22m,\u001b[1Cand\u001b[1Cyou\u001b[1Cwrite\u001b[1Cit\u001b[1Cback\u001b[1Cso\u001b[1Cthe\u001b[1C\u001b[3mnext\u001b[1C\u001b[23mverify\u001b[1Ccall\u001b[1Csees\u001b[1Cthe\u001b[1Clatest\u001b[1Cvalue.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                                                                                                                     \r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────"]
