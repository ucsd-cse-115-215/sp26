[0.893, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  That fourth condition is the whole reason \u001b[38;2;87;105;247mreq.session\u001b[39m and \u001b[38;2;87;105;247mreq.user\u001b[39m are separate properties. A pre-auth session — one  \r\u001b[1B  created\u001b[1Cby\u001b[1C\u001b[38;2;87;105;247mensureSession\u001b[1C\u001b[39mto\u001b[1Chold\u001b[1Ca\u001b[1Cregistration\u001b[1Cchallenge\u001b[1C—\u001b[1Chas\u001b[1C\u001b[38;2;87;105;247muser_id = NULL\u001b[39m.\u001b[1C\u001b[38;2;87;105;247mreq.session\u001b[1C\u001b[39mis\u001b[1Cset,\u001b[1Cbut\u001b[1C\u001b[38;2;87;105;247mreq.user\u001b[1C\u001b[39mis\r\u001b[1B  not. The auth guard (\u001b[38;2;87;105;247mrequireAuth\u001b[39m) checks \u001b[38;2;87;105;247mreq.user\u001b[39m specifically, so routes that require an authenticated user are gated\r\u001b[2C\u001b[1B correctly while\u001b[1Croutes\u001b[1Cmid-ceremony\u001b[1Ccan\u001b[1Cstill\u001b[1Cread\u001b[1C\u001b[38;2;87;105;247mreq.session\u001b[1C\u001b[39mto\u001b[1Cfind\u001b[1Ctheir\u001b[1Cchallenge.\r\r\n\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────"]
