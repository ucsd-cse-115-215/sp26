[0.511, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[38;2;87;105;247mconsumeSessionChallenge\u001b[39m is called \u001b[1mafter\u001b[22m destructuring \u001b[38;2;87;105;247mpending_user_handle\u001b[39m / \u001b[38;2;87;105;247mpending_display_name\u001b[39m in \u001b[38;2;87;105;247mregister/verify\u001b[39m.\r\u001b[1B   It\u001b[1Chas\u001b[1Cto\u001b[1Cbe\u001b[1C—\u001b[1Cthe\u001b[1Csnapshot\u001b[1Con\u001b[1C\u001b[38;2;87;105;247mreq.session\u001b[1C\u001b[39mwas\u001b[1Ctaken\u001b[1Cby\u001b[1Cmiddleware\u001b[1Cwhen\u001b[1Cthe\u001b[1Crequest\u001b[1Ccame\u001b[1Cin,\u001b[1Cso\u001b[1Cit\u001b[1Calready\u001b[1Chas\u001b[1Cthe\r\u001b[1B  pending values; calling \u001b[38;2;87;105;247mconsume\u001b[39m first doesn't affect them. Just putting it in this order so it's obvious the read     \r\u001b[2C\u001b[1Bprecedes the\u001b[1Cclear.\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m"]
