[0.049, "o", "\u001b[?2026h\u001b[81D\u001b[3B\r\u001b[4A  - \u001b[1m\"Account\" disappears from the UI.\u001b[22m It exists in the DB and in the auth code, and that's it.                          \r\u001b[1B          \u001b[1C     \u001b[1C          \u001b[1C  \u001b[1C    \u001b[1C    \u001b[1C    \u001b[1C  \u001b[1C    \u001b[1C      \u001b[1C \u001b[1C        \u001b[1C     \u001b[1C    \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39mRecovery isn't\u001b[1Cimpossible\u001b[1Cin\u001b[1Cthis\u001b[1Capp,\u001b[1Cbtw.\u001b[1CIf\u001b[1Cthey\u001b[1Cupload\u001b[1CN\u001b[1Creceipts\u001b[1Cwhose\u001b[1Cexa\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[81C\u001b[3A\u001b[?2026l"]
