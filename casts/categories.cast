[0.770, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[8AThe\u001b[1C\u001b[38;2;87;105;247mcategories\u001b[1C\u001b[39mtable\u001b[1Cthen\u001b[1Cexists\u001b[1Cprimarily\u001b[1Cas\u001b[1Ca\u001b[1Csoft-delete\u001b[1C/\u001b[1Chide-list\u001b[1C(\u001b[38;2;87;105;247mactive=0\u001b[39m)\u001b[1Cplus\u001b[1Ca\u001b[1Cplace\u001b[1Cto\u001b[1Chang\u001b[1Cthe\u001b[1Cseeds.\u001b[1CNo\r\u001b[2C\u001b[1Bref-counting bookke\u001b[1Cping,\u001b[1Cno drift between\u001b[1Ctable and items.\u001b[1CThe CRUD endpoints mostly write to the\u001b[2Cide\u001b[1Clist.     \u001b[1C  \r\u001b[2C\u001b[1B            \u001b[1C            \u001b[1C  \u001b[1C     \u001b[1C       \u001b[1C     \u001b[1C   \u001b[1C      \u001b[1C   \u001b[1C    \u001b[1C         \u001b[1C      \u001b[1C     \u001b[1C  \u001b[1C   \u001b[1C    \u001b[1C     \r\u001b[2C\u001b[1B\u001b[1m4. Delete semantics when items still reference it.\u001b[1C\u001b[22mThree\u001b[1Cchoices:\u001b[1Cblock,\u001b[1Ccascade-reassign\u001b[1Cto\u001b[1C\"Other\",\u001b[1Cor\u001b[1Csoft-delete\r\u001b[1B  (hide from suggestions, keep string on items). Soft-delete pairs naturally with #3 and is least destructive.          \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────"]
