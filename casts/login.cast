[0.853, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The only thing happening here is \u001b[1mcookie-id → DB session row → DB user row, attached to the request\u001b[22m. No crypto, no JWT,\r\u001b[1B   no\u001b[1Ccomplicated\u001b[1Cmachinery.\u001b[1CThe\u001b[1Ccookie\u001b[1Cis\u001b[1Cjust\u001b[1Can\u001b[1Copaque\u001b[1Ckey\u001b[1Cthe\u001b[1CDB\u001b[1Cdereferences.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;215;119;87m✶\u001b[1C\u001b[38;2;245;149;117mTra\u001b[38;2;215;119;87mnsmuting… \u001b[38;2;102;102;102m(16s · ↓\u001b[1C547 tokens)\u001b[39m\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────"]
