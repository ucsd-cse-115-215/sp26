[0.860, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The \u001b[38;2;87;105;247muser_handle\u001b[39m coming back on login is what replaces username as the lookup key. That's the whole point of the       \r\u001b[1B  random-blob\u001b[1Cuser\u001b[1Chandle\u001b[1C—\u001b[1Cit's\u001b[1Ca\u001b[1Cserver-generated\u001b[1Cidentifier\u001b[1Cthe\u001b[1Cauthenticator\u001b[1Ccan\u001b[1Creturn\u001b[1Cto\u001b[1Cyou\u001b[1Cwithout\u001b[1Cthe\u001b[1Cuser\u001b[1Cever\r\u001b[1B   having typed it.                                                                                                     \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────"]
