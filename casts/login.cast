[0.200, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[14C\u001b[5Aserver:\u001b[1Cverify\u001b[1CJWT,\u001b[1Cverify\u001b[1Cassertion\u001b[1Cagainst\u001b[1Cchallenge\u001b[1Cfrom\u001b[1CJWT\r\u001b[1B                                                                                                                        \r\u001b[1B  Pros:\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────"]
