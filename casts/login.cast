[0.128, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mWhat's deliberately missing\u001b[22m                                                                                           \r\u001b[1B   \r\u001b[1B  - No password hash column.                                                                                            \r\u001b[2C\u001b[1B- No email, no\u001b[1Cphone,\u001b[1Cno\u001b[1Cpassword\u001b[1Creset\u001b[1Ctokens.\u001b[48C                     \r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────"]
