[0.173, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Three new tables — \u001b[38;2;87;105;247musers\u001b[39m, \u001b[38;2;87;105;247mcredentials\u001b[39m, \u001b[38;2;87;105;247msessions\u001b[39m — plus one \u001b[38;2;87;105;247mALTER\u001b[39m on \u001b[38;2;87;105;247mreceipts\u001b[39m to add a nullable \u001b[38;2;87;105;247muser_id\u001b[39m FK. Full DDL is\r\u001b[1B   in\u001b[1C\u001b[38;2;87;105;247mreceipt-design.md:216-246\u001b[39m.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────"]
