[0.000, "o", "ie           \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 260 +\u001b[38;2;51;51;51m  user_id        INTEGER REFERENCES users(id) ON DELETE CASCADE,   -- NULL during an in-flight ceremony           \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 261 +\u001b[38;2;51;51;51m  challenge      TEXT,                          -- base64url; in-flight registration/login challenge              \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 262 +\u001b[38;2;51;51;51m  challenge_kind TEXT,                          -- 'register' | 'login' | NULL                                    \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 263 +\u001b[38;2;51;51;51m  expires_at     TEXT NOT NULL,                                                                                   \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 264 +\u001b[38;2;51;51;51m  created_at     TEXT NOT NULL DEFAULT (datetime('now'))                                                          \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 265 +\u001b[38;2;51;51;51m);             "]
