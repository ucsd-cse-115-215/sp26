[0.560, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Quick note on SimpleWebAuthn v13: its API takes and returns \u001b[38;2;87;105;247mUint8Array\u001b[39m for binary fields (\u001b[38;2;87;105;247mcredential.id\u001b[39m, \u001b[38;2;87;105;247mpublicKey\u001b[39m,   \r\u001b[1B  \u001b[38;2;87;105;247muserHandle\u001b[39m).\u001b[1CNode\u001b[1C\u001b[38;2;87;105;247mBuffer\u001b[1C\u001b[39mis\u001b[1Ca\u001b[1C\u001b[38;2;87;105;247mUint8Array\u001b[1C\u001b[39msubclass,\u001b[1Cso\u001b[1Cthe\u001b[1CDB→library\u001b[1Cdirection\u001b[1Cis\u001b[1Cfree;\u001b[1Cthe\u001b[1Clibrary→DB\u001b[1Cdirection\u001b[1Cneeds\r\u001b[1B   one \u001b[38;2;87;105;247mBuffer.from(u8)\u001b[39m at the boundary. Cheap, but worth calling out so it doesn't surprise us when we wire the         \r\u001b[2C\u001b[1Bhandlers.   \r\r\n\r\r\n\u001b[38;2;215;119;87m✶\u001b[1CComposing…\u001b[1C\u001b[38;2;102;102;102m(16s\u001b[1C·\u001b[1C↓\u001b[1C264\u001b[1Ctokens)\u001b[39m\r\r\n\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────────────────────"]
