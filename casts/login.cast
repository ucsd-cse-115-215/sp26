[0.866, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Our decision maps straight from the usernameless choice: we committed to \u001b[38;2;87;105;247mallowCredentials: []\u001b[39m at login, which only    \r\u001b[1B  works\u001b[1Cif\u001b[1Cthe\u001b[1Cauthenticator\u001b[1Ccan\u001b[1Cvolunteer\u001b[1Cthe\u001b[1Ccredential\u001b[1Cfrom\u001b[1Cits\u001b[1Clocal\u001b[1Cindex,\u001b[1Cwhich\u001b[1Conly\u001b[1Chappens\u001b[1Cfor\u001b[1Cdiscoverable\r\u001b[1B  credentials. \u001b[38;2;87;105;247mresidentKey: \"required\"\u001b[39m is the thing that enforces that promise at registration time.                    \r\u001b[2C\u001b[1B            \r\r\n\u001b[2COne\u001b[1Crelated\u001b[1Cfield\u001b[1Cto\u001b[1Ckeep\u001b[1Cstraight:\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────"]
[0.000, "o", "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
