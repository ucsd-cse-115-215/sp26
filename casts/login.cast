[0.000, "o", "\r\u001b[1B\u001b[38;2;36;138;61m 220 +\u001b[38;2;51;51;51m                                                                                                                  \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 221 +\u001b[38;2;51;51;51m### Goals                                                                                                         \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 222 +\u001b[38;2;51;51;51m                                                                                                                  \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 223 +\u001b[38;2;51;51;51m- Per-user scoping of receipts.                                                                                   \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 224 +\u001b[38;2;51;51;51m- Passkey-only authentication — no passwords.                                                                     \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 225 +\u001b[38;2;51;51;51m- Minimal data retained about each user: no email, no"]
