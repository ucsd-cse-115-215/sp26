[0.235, "o", "\u001b[?2026h\u001b[1;39r\u001b[1;1H\u001b[5M\u001b[35;1H\u001b[38;5;130m 40 \u001b[39m  \u001b[36mconst\u001b[39m maxLen = \u001b[32mMath\u001b[39m.\u001b[38;5;130mmax\u001b[39m(\u001b[35mexpected\u001b[39m.\u001b[35mitems\u001b[39m.\u001b[38;5;130mlength\u001b(B\u001b[m\u001b[35m, actual\u001b[39m.\u001b[35mitems\u001b[39m.\u001b[38;5;130mlength\u001b[39m);\r\n\u001b[38;5;130m 41 \u001b[39m  \u001b[38;5;130mfor\u001b[39m (\u001b[36mlet\u001b[39m i = \u001b[32m0\u001b[38;5;130m;\u001b[39m i < maxLen\u001b[38;5;130m;\u001b[39m i++) \u001b[36m{\r\n\u001b[38;5;130m 42 \u001b[39m    \u001b[36mconst\u001b[39m exp = expected.items[i];\r\n\u001b[38;5;130m 43 \u001b[39m    \u001b[36mconst\u001b[39m act = actual.items[i];\r\n\u001b[38;5;130m 44 \u001b[39m\u001b[40;102H\u001b[1K\u001b[C44,0-1\u001b[9X\u001b[40;118H5%\u001b[K\u001b[1;40r\u001b[39;5H\u001b[?2026l"]
