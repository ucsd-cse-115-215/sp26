[0.964, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.200, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1m\"preferred\"\u001b[1C\u001b[22m\u001b[39m—\u001b[1Cauthenticator\u001b[1Cmay\u001b[1Cor\u001b[1Cmay\u001b[1Cnot\u001b[1Cmake\u001b[1Cit\u001b[1Cdiscoverable,\u001b[1Cat\u001b[1Cits\u001b[1Cown\u001b[1Cdiscretion.\u001b[1CRisky\u001b[1Cfor\u001b[1Cus:\u001b[1Ca\u001b[1Cuser\u001b[1Con\u001b[1Can\r\u001b[1B  older authenticator could silently get a non-discoverable credential, then fail to log in because our                 \r\u001b[1B  \u001b[38;2;87;105;247mallowCredentials: []\u001b[1C\u001b[39mflow\u001b[1Ccan't\u001b[1Cfind\u001b[1Cit.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m"]
[0.000, "o", "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.777, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1m\"discouraged\"\u001b[1C\u001b[22m\u001b[39m—\u001b[1Cauthenticator\u001b[1Cshould\u001b[1Cavoid\u001b[1Cdiscoverable.\u001b[1CRight\u001b[1Cpick\u001b[1Cif\u001b[1Cyou're\u001b[1Ckeeping\u001b[1Ca\u001b[1Cusername\u001b[1Cfield\u001b[1Cand\u001b[1Clooking\r\u001b[1B  credentials up server-side.                                                                                           \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
