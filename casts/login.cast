[0.420, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1muser_handle\u001b[1C\u001b[22m\u001b[39m—\u001b[1Cthis\u001b[1Cis\u001b[1C\u001b[1mnot the same as \u001b[38;2;87;105;247mid\u001b[1C\u001b[22m\u001b[39mand\u001b[1Cit\u001b[1Cmatters.\u001b[1CWebAuthn\u001b[1Chas\u001b[1Ca\u001b[1Cconcept\u001b[1Ccalled\u001b[1C\"user\u001b[1Chandle\"\u001b[1C(up\u001b[1Cto\u001b[1C64\r\u001b[1B  bytes, opaque) that gets baked into the credential at registration time and returned by the authenticator on every    \r\u001b[1B  login.\u001b[1CSpec\u001b[1Csays\u001b[1Cit\u001b[1C\"MUST\u001b[1CNOT\u001b[1Ccontain\u001b[1Cpersonally\u001b[1Cidentifying\u001b[1Cinformation\"\u001b[1C—\u001b[1Cso\u001b[1C\u001b[38;2;87;105;247musername\u001b[1C\u001b[39mis\u001b[1Ca\u001b[1Cbad\u001b[1Cchoice,\u001b[1Cand\u001b[1Ceven\u001b[1Can\r\u001b[1B  auto-incrementing \u001b[38;2;87;105;247mid\u001b[39m is discouraged because it leaks user count. Standard move: a random 16-byte value. We store it so\r\u001b[2C\u001b[1B we can map an\u001b[1Cincoming\u001b[1Cassertion\u001b[1Cback\u001b[1Cto\u001b[1Ca\u001b[1Cuser\u001b[1Cduring\u001b[1Cdiscoverable\u001b[1C(usernameless)\u001b[1Clogin.\u001b[5C                     \r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────"]
[0.000, "o", "────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.367, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  If you decide you never want discoverable login, you can drop \u001b[38;2;87;105;247muser_handle\u001b[39m and just use \u001b[38;2;87;105;247mid\u001b[39m. But 16 bytes of randomness \r\u001b[1B  is\u001b[1Ccheap\u001b[1Cinsurance.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────"]
