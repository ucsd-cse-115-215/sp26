[0.037, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[7A\u001b[38;2;0;0;0m⏺\u001b[1C\u001b[39mNo, usernames are not required. You can build a flow\u001b[1Cwhere\u001b[1Cthe\u001b[1Cuser\u001b[1Cnever\u001b[1Ctypes\u001b[1Canything\u001b[1Cat\u001b[1Call\u001b[1C—\u001b[1Cclick\u001b[1C\"Sign\u001b[1Cup,\"\r\u001b[1B  Touch ID, done. This is what WebAuthn calls \u001b[1mdiscoverable credentials\u001b[22m (sometimes \"resident\u001b[1Ckeys\"\u001b[1Cin\u001b[1Colder\u001b[1Cdocs),\u001b[1Cand\r\u001b[2C\u001b[1Bmodern\u001b[1Cpasskeys\u001b[1Csupport\u001b[1Cit\u001b[1Cout\u001b[1Cof\u001b[1Cthe\u001b[1Cbox.\r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[1mWhat the protocol actually requires\r\u001b[1B\u001b[22m                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.120, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  At registration, the options object needs three things in its \u001b[38;2;87;105;247muser\u001b[39m field:                                             \r\u001b[1B   \r\u001b[1B  user: {                                                                                                               \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────────────────"]
