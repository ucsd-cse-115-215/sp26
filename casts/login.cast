[0.567, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[38;2;87;105;247m\u001b[1m\"required\"\u001b[22m\u001b[39m — authenticator \u001b[3mmust\u001b[23m create a discoverable credential, or the registration fails. This is what we want,  \r\u001b[1B  because\u001b[1Cour\u001b[1Clogin\u001b[1Cflow\u001b[1Crelies\u001b[1Con\u001b[1Cdiscoverability\u001b[1C(empty\u001b[1C\u001b[38;2;87;105;247mallowCredentials\u001b[39m).\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────"]
