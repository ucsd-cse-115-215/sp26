[0.0, "o", "\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u001b[36;1H\u001b(B\u001b[m\u001b[?2026h\u001b[36;132H\n\u001b[2G\u001b[1K\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241mI\u001b[39m\u001b[K\u001b[?2026l\u001b[38;5;241mNSERT\u001b[C--\u001b[36;115H\u25cf\u001b[C\u001b(B\u001b[m"]
