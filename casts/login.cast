[0.387, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5A↓\r\u001b[1B  Authenticator returns assertion + user_handle.                                                                        \r\u001b[1B  Server\u001b[1Clooks\u001b[1Cup\u001b[1Cuser_handle,\u001b[1Ccreates\u001b[1Csession.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────"]
