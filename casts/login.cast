[0.002, "o", "\u001b[?2026h\u001b[86D\u001b[3B\r\u001b[6A\u001b[48;2;240;240;240m\u001b[38;2;175;175;175m❯ \u001b[38;2;0;0;0mA check for myself: there are 3 entities we're talking about here: the authenticator, which is a client concept and \u001b[39m  \r\u001b[1B  \u001b[38;2;0;0;0mis like a browser plugin or the keychain in ios or like a yubikey. Then there's the browser, which has some protocol \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0m for talking to the authenticator. The browser mediates the connection to the server.\u001b[39m                                 \r\u001b[2C\u001b[1B\u001b[49m   \u001b[1C       \u001b[1C  \u001b[1C   \u001b[1C              \u001b[1C   \u001b[1C       \u001b[1C        \u001b[1C   \u001b[1C          \u001b[1C  \u001b[1C   \u001b[1C        \r\u001b[1B\u001b[38;2;215;119;87m✶\u001b[39m \u001b[38;2;215;119;87mWorking… \u001b[39m                                                                                                             \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────"]
