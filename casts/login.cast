[0.724, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[7A-\u001b[1CSlightly\u001b[1Cmore\u001b[1Cverbose\u001b[1Con\u001b[1Cevery\u001b[1Cwrite.\r\u001b[2C\u001b[1B \u001b[1C        \u001b[1C    \u001b[1C       \u001b[1C  \u001b[1C     \u001b[1C      \r\u001b[2C\u001b[1BLow-cost\u001b[1Cupgrade\u001b[1Cfrom\u001b[1Cwhat\u001b[1Cwe\u001b[1Chave.\u001b[1CMostly\u001b[1Ca\u001b[1Cdocumentation/safety\u001b[1Cwin.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                                                                                                                     \r\u001b[1B\u001b[38;2;153;153;153m─────────────────────────"]
