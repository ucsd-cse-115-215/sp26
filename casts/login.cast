[0.075, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[1mLogout\u001b[22m — we'll \u001b[38;2;87;105;247mDELETE FROM sessions WHERE id = ?\u001b[39m, not reset \u001b[38;2;87;105;247muser_id\u001b[39m to NULL. The row goes away entirely.            \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.413, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mSession expiry post-auth\u001b[1C\u001b[22m—\u001b[1Csame:\u001b[1Cthe\u001b[1Cpruner\u001b[1Cdeletes\u001b[1Cthe\u001b[1Crow.\r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[1mWhy \u001b[38;2;87;105;247mrequireAuth\u001b[39m checks \u001b[38;2;87;105;247mreq.user\u001b[39m, not \u001b[38;2;87;105;247mreq.session\r\u001b[1B\u001b[22m\u001b[39m                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────"]
