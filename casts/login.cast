[0.324, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A2.\u001b[1C\u001b[1mMigration of existing receipts.\u001b[1C\u001b[22mYou\u001b[1Chave\u001b[1Creceipts\u001b[1Cin\u001b[1C\u001b[38;2;87;105;247mreceipts.db\u001b[1C\u001b[39malready.\u001b[1COptions:\u001b[1C(a)\u001b[1Cwipe\u001b[1Cthe\u001b[1Cdev\u001b[1CDB,\u001b[1C(b)\u001b[1Cassign\r\u001b[1B  existing rows to a \"legacy\" user on first migration, (c) leave them orphaned and only new receipts are scoped. Which  \r\u001b[1B  fits\u001b[1Chow\u001b[1Cyou're\u001b[1Cusing\u001b[1Cthis?\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────"]
