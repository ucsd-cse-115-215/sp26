[0.208, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - Four tables: \u001b[38;2;87;105;247musers\u001b[39m, \u001b[38;2;87;105;247mcredentials\u001b[39m, \u001b[38;2;87;105;247msessions\u001b[39m, and the modified \u001b[38;2;87;105;247mreceipts\u001b[39m (with \u001b[38;2;87;105;247muser_id NOT NULL\u001b[39m FK). \u001b[38;2;87;105;247mreceipt_items\u001b[39m      \r\u001b[1B  unchanged.\u001b[1CAll\u001b[1C\u001b[38;2;87;105;247mCREATE TABLE IF NOT EXISTS\u001b[39m,\u001b[1Cindexes\u001b[1Con\u001b[1C\u001b[38;2;87;105;247mcredentials.user_id\u001b[39m,\u001b[1C\u001b[38;2;87;105;247msessions.expires_at\u001b[39m,\u001b[1C\u001b[38;2;87;105;247mreceipts.user_id\u001b[39m.\r\u001b[1B  \u001b[38;2;87;105;247mpruneExpiredSessions\u001b[39m runs at startup.                                                                                 \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────────────────────────────────────"]
