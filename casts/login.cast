[0.161, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mAllows top-level navigation GETs\u001b[1C\u001b[22m—\u001b[1Cif\u001b[1Csomeone\u001b[1Cemails\u001b[1Ca\u001b[1Clink\u001b[1Cto\u001b[1C\u001b[38;2;87;105;247myoursite.com/receipts/42\u001b[39m,\u001b[1Cclicking\u001b[1Cit\u001b[1Ccarries\u001b[1Cthe\r\u001b[1B  cookie and the user arrives already logged in. This is the UX concession over Strict.                                 \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
