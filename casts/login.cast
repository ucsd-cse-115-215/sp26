[0.510, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1CThe\u001b[1Ctripwire\u001b[1Cfor\u001b[1Cphysically-extracted\u001b[1Chardware\u001b[1Ckeys.\u001b[1CWorth\u001b[1Capproximately\u001b[1Cnothing\u001b[1Cfor\u001b[1Ca\u001b[1Creceipt\u001b[1Capp;\u001b[1Cworth\u001b[1Cmore\u001b[1Cfor\u001b[1Ca\r\u001b[1B   bank.                                                                                                                \r\u001b[1B   \r\u001b[1B  What you gain:                                                                                                        \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────"]
