[0.004, "o", "\u001b[?2026h\u001b[44D\u001b[3B\r\u001b[7A\u001b[48;2;240;240;240m\u001b[38;2;175;175;175m❯ \u001b[38;2;0;0;0mOK let's proceed with what we have. I want to log a few things to a \"production-readiness\" list in the design doc:\u001b[39m    \r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;0;0;0m- Soft deletes (right now we do hard deletes on receipt items)\u001b[39m                                                        \r\u001b[1B  \u001b[38;2;0;0;0m- More well-defined structure for mid-auth\u001b[39m                                                                            \r\u001b[2C\u001b[1B\u001b[49m \u001b[1C    \u001b[1C            \u001b[1C         \u001b[1C   \u001b[1C         \r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[39m \u001b[38;2;245;149;117mRe\u001b[38;2;215;119;87mcombobulating… \u001b[39m                                                                                                     \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m──────────────────────────────────"]
