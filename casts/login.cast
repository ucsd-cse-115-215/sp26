[0.547, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Stay with the nullable-flag design — it's standard, it compiles, and the security properties are fine as long as      \r\u001b[1B  \u001b[38;2;87;105;247mrequireAuth\u001b[1C\u001b[39mis\u001b[1Cthe\u001b[1Conly\u001b[1Cway\u001b[1Croutes\u001b[1Clearn\u001b[1Cabout\u001b[1C\u001b[38;2;87;105;247mreq.user\u001b[39m.\u001b[1CIf\u001b[1Cyou\u001b[1Cwant\u001b[1Ca\u001b[1C~5-line\u001b[1Chardening,\u001b[1Cadd\u001b[1C#2's\u001b[1C\u001b[38;2;87;105;247mCHECK\u001b[1C\u001b[39mconstraint\u001b[1Cto\r\u001b[1B   make invalid rows un-insertable:                                                                                     \r\u001b[2C\u001b[1B            \r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────"]
