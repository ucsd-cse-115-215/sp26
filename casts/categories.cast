[0.102, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A4.\u001b[1C\u001b[1mRename at this size is a one-liner either way.\u001b[1C\u001b[22m\u001b[38;2;87;105;247mUPDATE receipt_items SET category=? WHERE category=?\u001b[1C\u001b[39min\u001b[1Ca\r\u001b[1B  transaction. FK makes it marginally cleaner, not meaningfully so.                                                     \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.783, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A5.\u001b[1C\u001b[1mCase/whitespace normalization is needed either way.\u001b[1C\u001b[22mFK\u001b[1Cdoesn't\u001b[1Csave\u001b[1Cyou\u001b[1Cfrom\u001b[1C\u001b[38;2;87;105;247m\"groceries\"\u001b[1C\u001b[39mvs\u001b[1C\u001b[38;2;87;105;247m\"Groceries\"\u001b[1C\u001b[39m—\u001b[1Cyou\u001b[1Cstill\r\u001b[1B   have to canonicalize at write time before lookup.                                                                    \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
