[0.134, "o", "\u001b[?2026h\u001b[49D\u001b[3B\r\u001b[5A  Clean: add a \u001b[38;2;87;105;247mbooks\u001b[39m table keyed on \u001b[38;2;87;105;247muser_id\u001b[39m, move the \u001b[38;2;87;105;247mdisplay_name\u001b[39m over to it, add a \u001b[38;2;87;105;247musers.display_name\u001b[39m that starts as  \r\u001b[1B  \"Ac\u001b[2Cunt\"\u001b[1Cor sim\u001b[1Clar and is barely\u001b[1Csurfaced\u001b[2CExisting users\u001b[1Cbecom\u001b[1C one-bo\u001b[1Ck users automatically. You'd\u001b[1Crename \"receipt\r\u001b[2C\u001b[1B book\" to\u001b[1Cstay on th\u001b[2Cbook concept, and introduce\u001b[1Csomething\u001b[1Cperipheral\u001b[1Clike\u001b[1C\"profile\"\u001b[1Cfor\u001b[1Cthe\u001b[1Caccount\u001b[1Clayer.\u001b[1CCost:\r\u001b[1B  maybe a day, no data loss.                                                                                            \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────────────────────────────────────"]
