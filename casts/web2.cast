[0.0, "o", "                                                         \u001b[39m\u001b[49m\u001b[K\u001b[33;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  67 +\u001b[38;2;51;51;51m                                                                                                                  \u001b[39m\u001b[49m\u001b[K\u001b[34;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  68 +\u001b[38;2;51;51;51m## Backend & Frontend                                                                                             \u001b[39m\u001b[49m\u001b[K\u001b[35;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  69 +\u001b[38;2;51;51;51m                                                                                                                  \u001b[39m\u001b[49m\u001b[K\u001b[36;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  70 +\u001b[38;2;51;51;51m### Storage \u001b[39m\u001b[49m\u001b[K\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m\u2014\u001b[39m\u001b[49m\u001b[36;132H\n\u001b[35;25H\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m SQLite                                                                                              \u001b[39m\u001b[49m\r\n\u001b[K\u001b[36;6H\u001b[?2026l\u001b[?2026h\u001b[36;132H\n\u001b[35;6H\u001b[3"]
[0.0, "o", "8;2;36;138;61m\u001b[48;2;220;255;220m  71 +\u001b[38;2;51;51;51m                                                                                                                  \u001b[39m\u001b[49m\u001b[36;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  72 +\u001b[38;2;51;51;51mAll money amounts are stored as **integer cents** to avoid floating-point rounding errors (e.g. `$12.49` \u001b[39m\u001b[49m\u001b[K\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m\u2192\u001b[39m\u001b[49m\r\u001b[3S\u001b[33;118H\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m `1249`)\u001b[39m\u001b[49m\u001b[34;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51m. The AI parser returns decimal dollars, so we convert at the save boundary: `Math.round(dollars * 100)`.         \u001b[39m\u001b[49m\u001b[K\u001b[35;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  73 +\u001b[38;2;51;51;51m                                                                                                                  \u001b[39m\u001b[49m\u001b[K\u001b[36;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  74 +\u001b[38;2;51;51;51mNo receipt images are stored \u001b[39m\u001b[49m\u001b[K\u001b[38;2;51;51;51m\u001b[48;2;220;2"]
