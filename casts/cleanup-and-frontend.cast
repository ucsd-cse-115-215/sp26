[0.058, "o", "\u001b[35d            \u001b[35;111H\u001b[38;5;241mChecking for\u001b[Cupdates\u001b[36;3H--\u001b[CINSERT\u001b[C--\u001b[36;115H\u25cf\u001b[Chigh\u001b[C\u00b7\u001b[39m\u001b[36;132H\n\u001b[35;124H\u001b[38;5;241m/effort\u001b[39m\r\n\u001b[K\u001b[32;3H\u001b[?2026h\u001b[?2026l"]
[0.104, "o", "\u001b[1;5Hexpect(res.status).toBe(\u001b[32m201\u001b[39m);                                                                                            \u001b[2;5H\u001b[34mconst\u001b[39m created\u001b[C=\u001b[C\u001b[34mawait\u001b[C\u001b[39mres.json();\u001b[3;5Hexpect(created.total).toBe(\u001b[36mMath\u001b[39m.round(parsed.total * \u001b[32m100\u001b[39m));                                                              \u001b[4;5Hexpect(created.items).toHaveLength(parsed.items.length);                                                                 \u001b[5;3H});      \u001b[6;6H                                                                                                                        \u001b[7;3HThe other option is Node's built-in \u001b[38;5;105mnode:test\u001b[39m + \u001b[38;5;105mnode:assert\u001b[39m, which avoids adding a dependency. But the reporting is bare-bones\u001b[Cand\u001b[8;4Hrunning it with TypeScript via tsx requires some wiring.                                                                  \u001b[9;6H                                                       "]
[0.0, "o", "                                                                 \u001b[10;3HI'd go with vitest \u2014 one dev dependency, zero config, and it replaces all the custom assertion/reporting code.             \u001b[11;6H                                                                                                                        \r\n\u001b[38;5;248m\u001b[48;5;255m\u276f \u001b[38;5;16mWhat's the wiring to use the builtin node:test? I like not adding deps and I've never used that before\u001b[39m                            \u001b[13;6H\u001b[49m                                                                                                                        \r\n\u001b[38;5;16m\u23fa\u001b[C\u001b[39mThe\u001b[Cmain\u001b[Cwiring\u001b[Cissue\u001b[Cis\u001b[Cthat\u001b[C\u001b[38;5;105mnode:test\u001b[C\u001b[39mdoesn't\u001b[Cknow\u001b[Cabout\u001b[CTypeScript.\u001b[CYou'd\u001b[Crun\u001b[Cit\u001b[Cthrough\u001b[C\u001b[38;5;105mtsx\u001b[C\u001b[39mlike:\r\n \u001b[C   \u001b[C  \u001b[C      \u001b[C   \u001b[C    \u001b[C       \u001b[C     \u001b[C       \u001b[C    \u001b[16;3Hnpx\u001b[Ctsx\u001b[C--\u001b[36mtest\u001b[Ctest\u001b[39m/api.test.ts\r\n \u001b[C        \u001b[C    \u001b[C     \r"]
[0.0, "o", "\r\n  That's it \u2014 \u001b[38;5;105mtsx\u001b[39m handles the TypeScript\u001b[Ccompilation,\u001b[C\u001b[38;5;105mnode:test\u001b[C\u001b[39mhandles\u001b[Cthe\u001b[Ctest\u001b[Crunner.\u001b[CThe\u001b[CAPI\u001b[Clooks\u001b[Clike:\u001b[19;6H \u001b[C   \u001b[C      \u001b[C                \u001b[20;3H\u001b[34mimport\u001b[39m { test, describe, before, after\u001b[C}\u001b[C\u001b[34mfrom\u001b[C\u001b[31m\"node:test\"\u001b[39m;\u001b[21;3H\u001b[34mimport\u001b[C\u001b[39massert\u001b[C\u001b[34mfrom\u001b[C\u001b[31m\"node:assert/strict\"\u001b[39m;\r\n \u001b[C        \u001b[C      \u001b[C   \u001b[C      \u001b[C   \u001b[C   \u001b[C    \u001b[23;3Htest(\u001b[31m\"example\"\u001b[39m, \u001b[33m() =>\u001b[39m { \u001b[C    \u001b[C   \u001b[C   \u001b[C                  \u001b[C   \u001b[C        \u001b[24;3H \u001b[Cassert.equal(\u001b[32m1\u001b[39m + \u001b[32m1\u001b[39m, \u001b[32m2\u001b[39m);      \u001b[C                  \u001b[C              \u001b[C           \u001b[25;3H \u001b[Cassert.de\u001b[CpStrictEqual({ \u001b[36ma\u001b[39m: \u001b[32m1\u001b[39m },\u001b[C{\u001b[C\u001b[36ma\u001b[39m:\u001b[C\u001b[32m1\u001b[C\u001b[39m});\u001b[26;3H});   \u001b[C         \u001b[C          \u001b[C      \u001b[C        \u001b[C     \u001b[C          \u001b[C         \u001b[C   \u001b[C         \u001b[27;3H \u001b[C        \u001b[C       \u001b[C    \u001b[C        \u001b[28;3H\u001b[38;5;105ma\u001b(B\u001b[m"]
[0.0, "o", "\u001b[38;5;105mssert.equal\u001b[C\u001b[39mfor\u001b[Cprimitives,\u001b[C\u001b[38;5;105massert.deepStrictEqual\u001b[C\u001b[39mfor\u001b[Cobjects/arrays.\u001b[COn\u001b[Cfailure\u001b[Cyou\u001b[Cget\u001b[Ca\u001b[Cdiff\u001b[Cshowing\u001b[Cexpected\u001b[Cvs\u001b[Cactual\u001b[C\u2014\u001b[Cno\r\n \u001b[Ccustom error messages\u001b[Cneeded.\u001b[31;1H  The one quirk: \u001b[38;5;105mnode:test\u001b[39m runs each file as a subprocess by default, which can conflict with \u001b[38;5;105mtsx\u001b[39m. The \u001b[38;5;105m--test\u001b[39m flag on \u001b[38;5;105mtsx\u001b[39m makes it  \u001b[32;1H  work\u001b[Cbecause\u001b[Ctsx\u001b[Chandles\u001b[Cthe\u001b[Cexecution\u001b[Cdirectly.\r\n                                                                                                                                    \u001b[34;3HWant\u001b[Cme\u001b[Cto\u001b[Cgo\u001b[Cwith\u001b[Cthis?\u001b[34;111H                    \u001b[35;3H            \u001b[35;115H                \r\n\u001b[38;5;248m\u001b[48;5;255m\u276f\u001b[39m\u001b[49m\r\u001b[2S\u001b[34;2H\u001b[38;5;248m\u001b[48;5;255m \u001b[38;5;16mOh that doesn't seem like bad wiring. Let's use the builtin node:test for this.\u001b[39m                                                   \u001b[49m\u001b[35;1H\u001b[K\r\n\u001b[K\u001b[38;5;65m\u23fa\u001b[C\u001b[39m\u001b[1mWrite\u001b(B\u001b"]
