[0.515, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[29C\u001b[14A┬\u001b[2C─\u001b[22C─\u001b[9C┬\r\u001b[12C\u001b[1BRelation \u001b[8C│\u001b[2C \u001b[5C    Card\u001b[1Cnality\u001b[2C \u001b[9C│\u001b[16C     Example\r\u001b[29C\u001b[1B┼\u001b[2C─\u001b[22C─\u001b[9C┼\r\u001b[20C\u001b[1B         │\u001b[1C\u001b[1mmany-to\u001b[1Cmany\u001b[22m   \u001b[9C \u001b[1C       \u001b[1C│\u001b[1CYubiKey 5 NFC supports \u001b[38;2;87;105;247m{usb, nfc}\u001b[39m. \u001b[38;2;87;105;247minternal\u001b[39m is\r\u001b[4C\u001b[1Btr\u001b[1Cnsport (capability)\u001b[3C│\u001b[2C \u001b[22C \u001b[1C  \u001b[1C     │ supp\u001b[2Cted by every platform\u001b[1Cauthenticator.\r\u001b[29C\u001b[1B┼\u001b[2C─\u001b[22C─\u001b[9C┼\r\u001b[20C\u001b[1B         │\u001b[1C\u001b[1mone-to\u001b[1Cmany\u001b[22m (but see sync) \u001b[1C      │\u001b[1CA YubiKey can\u001b[1Chol\u001b[1C many credentials. iPhone     \r\u001b[4C\u001b[1Bcredential\u001b[15C│\u001b[2C \u001b[2C     \u001b[15C \u001b[2C     \u001b[1C │ Secure\u001b[1CEnclave\u001b[1Cholds\u001b[1Cmany.\r\u001b[2C\u001b[1B├\u001b[26C┼\u001b[2C─\u001b[22C─\u001b[9C┼\u001b[50C┤\r\u001b[2C\u001b[1B│\u001b[1CCredential\u001b[1C↔\u001b[13C│\u001b[1C\u001b[1mone-to-one\u001b[1C\u001b[22mhistorically;\u001b[10C│\u001b[1CAn\u001b[1CiCloud\u001b[1Cpasskey\u001b[1Cphysically\u001b[1Cexists\u001b[1Cin\u001b[1Cboth\u001b[1Cyour\u001b[1C│\r\u001b[1B  │ authenticator            │ \u001b[1mone-to-many\u001b[22m with synced pa"]
