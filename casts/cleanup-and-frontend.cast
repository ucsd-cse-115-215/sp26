[0.209, "o", "\u001b[32;1H  \u001b[38;5;105m\u001b[1mlocalStorage\u001b(B\u001b[m \u2014 same as sessionStorage but persists across tabs/sessions. Same 5MB limit, same size concern.                       \u001b[33;1H   \u001b[35;1H\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[7m \u001b(B\u001b[m           \r\n\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[36;1H\u001b[2S\u001b[35;2H\u001b[1K\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241mINSERT\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[K\r\n\u001b[K\u001b[33;3H"]
