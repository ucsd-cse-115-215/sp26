[0.067, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;2;0;0;0m⏺\u001b[1C\u001b[39mTwo different fields, both named \"RP something,\"\u001b[1Cwhich\u001b[1Cis\u001b[1Ca\u001b[1Cspec\u001b[1Cnaming\u001b[1Csin.\u001b[1CYou'll\u001b[1Csee\u001b[1Cboth\u001b[1Cin\u001b[1Cthe\u001b[1Clibrary\u001b[1CAPI.\r\r\n\r\n\r\n\r\n\r\n\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.504, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mRP ID — a domain name, security-critical\u001b[22m                                                                              \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.248, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.362, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  This is the one that matters. It's a DNS name (\u001b[1mnot\u001b[22m a URL, no protocol, no port, no path), and the credential is       \r\u001b[1B  cryptographically\u001b[1Cbound\u001b[1Cto\u001b[1Cit\u001b[1Cby\u001b[1Cthe\u001b[1Cauthenticator.\u001b[1CExamples:\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.411, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[38;2;87;105;247mlocalhost\u001b[39m (special-cased for dev)                                                                                   \r\u001b[1B  -\u001b[1C\u001b[38;2;87;105;247mreceipts.example.com\r\u001b[1B\u001b[39m  - \u001b[38;2;87;105;247mexample.com\u001b[39m                                                                                                         \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.191, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.462, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  A credential born under \u001b[38;2;87;105;247mrpID = \"localhost\"\u001b[39m cannot be used on \u001b[38;2;87;105;247mreceipts.example.com\u001b[39m, ever. The authenticator refuses.   \r\u001b[1B  Users\u001b[1Cwould\u001b[1Chave\u001b[1Cto\u001b[1Cre-enroll.\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1B\u001b[1mRules the browser enforces:\u001b[22m\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.504, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.653, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - Must equal the page's origin host, or a \u001b[1mregisterable suffix\u001b[22m of it. If your page is served from \u001b[38;2;87;105;247mreceipts.example.com\u001b[39m,\r\u001b[1B   you\u001b[1Ccan\u001b[1Cuse\u001b[1C\u001b[38;2;87;105;247mreceipts.example.com\u001b[1C\u001b[39mor\u001b[1C\u001b[38;2;87;105;247mexample.com\u001b[1C\u001b[39mas\u001b[1Cthe\u001b[1CRP\u001b[1CID\u001b[1C—\u001b[1Cbut\u001b[1Cnot\u001b[1C\u001b[38;2;87;105;247mexample.org\u001b[39m,\u001b[1Cnot\u001b[1C\u001b[38;2;87;105;247mfoo.receipts.example.com\u001b[39m,\u001b[1Cnot\r\u001b[1B   some arbitrary string.                                                                                               \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2"]
[0.000, "o", ";153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.304, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.150, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1CCan't\u001b[1Cbe\u001b[1Ca\u001b[1Cpublic\u001b[1Csuffix\u001b[1C(\u001b[38;2;87;105;247m.com\u001b[39m,\u001b[1C\u001b[38;2;87;105;247m.co.uk\u001b[39m)\u001b[1C—\u001b[1CeTLD\u001b[1Crule.\r\u001b[1B  - Can't be an IP address.                                                                                             \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.403, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mRP Name — a display string, cosmetic\u001b[22m                                                                                  \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.409, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.961, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.112, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Free-form text like \u001b[38;2;87;105;247m\"Receipt Book\"\u001b[39m. Some authenticators show it in their UI (\"Save a passkey for \u001b[1mReceipt Book\u001b[22m?\"), many\r\u001b[1B   ignore\u001b[1Cit.\u001b[1CSafe\u001b[1Cto\u001b[1Cchange\u001b[1Clater\u001b[1C—\u001b[1Cit\u001b[1Cisn't\u001b[1Cbound\u001b[1Cto\u001b[1Canything.\u001b[1CThis\u001b[1Cis\u001b[1Cthe\u001b[1Cone\u001b[1Cthat\u001b[1Csounds\u001b[1Clike\u001b[1C\"name\u001b[1Cof\u001b[1Cour\u001b[1Capp\u001b[1Cfrom\r\u001b[1B  the passkey UI POV,\" and that's exactly what it is.                                                                   \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.692, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mThe considerations for picking RP ID in prod\u001b[22m                                                                          \r\u001b[1B   \r\u001b[1B  Three real decisions:                                                                                                 \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────────────────────"]
[0.001, "o", "───────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.156, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.330, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1m1. Pick before users enroll.\u001b[22m Changing RP ID is a mass re-enrollment event. For this app where you have zero users, you\r\u001b[1B   have\u001b[1Ca\u001b[1Cfree\u001b[1Cwindow.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.635, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.082, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1m2. Pick the broadest suffix you'd want to share credentials across.\u001b[22m The asymmetry to know:                            \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.819, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - RP ID = \u001b[38;2;87;105;247mexample.com\u001b[39m → credential works on \u001b[38;2;87;105;247mexample.com\u001b[39m, \u001b[38;2;87;105;247mapp.example.com\u001b[39m, \u001b[38;2;87;105;247manything.example.com\u001b[39m. Migration to a        \r\u001b[1B  subdomain\u001b[1Clater\u001b[1Cis\u001b[1Cfree.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.060, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.962, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1CRP\u001b[1CID\u001b[1C=\u001b[1C\u001b[38;2;87;105;247mreceipts.example.com\u001b[1C\u001b[39m→\u001b[1Ccredential\u001b[1Cworks\u001b[1Conly\u001b[1Con\u001b[1Cthat\u001b[1Csubdomain.\u001b[1CMoving\u001b[1Cto\u001b[1C\u001b[38;2;87;105;247mexample.com\u001b[1C\u001b[39mlater\u001b[1C\u001b[3mdoes not\u001b[1C\u001b[23mwork\u001b[1C—\r\u001b[1B  the credential is narrower than the target.                                                                           \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.000, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.458, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  So: err broad. If there's any chance \u001b[38;2;87;105;247mauth.example.com\u001b[39m or \u001b[38;2;87;105;247mapp.example.com\u001b[39m might one day share accounts, set \u001b[38;2;87;105;247mrpID = \u001b[39m    \r\u001b[1B  \u001b[38;2;87;105;247m\"example.com\"\u001b[1C\u001b[39mfrom\u001b[1Cthe\u001b[1Cstart.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────"]
[0.000, "o", "────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.503, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.963, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.125, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1m3. Mind the dev-to-prod boundary.\u001b[22m \u001b[38;2;87;105;247mlocalhost\u001b[39m credentials won't work on prod and vice versa. This is normal — you       \r\u001b[1B  re-enroll\u001b[1Clocally.\u001b[1CFor\u001b[1Cstaging,\u001b[1Ceither\u001b[1Cuse\u001b[1C\u001b[38;2;87;105;247mlocalhost\u001b[39m-equivalents\u001b[1Cor\u001b[1Cpick\u001b[1Ca\u001b[1Cdedicated\u001b[1Cstaging\u001b[1Cdomain;\u001b[1Cdon't\u001b[1Cshare\r\u001b[1B  staging and prod RP IDs.                                                                                              \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.414, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mRelated field: \u001b[38;2;87;105;247mexpectedOrigin\u001b[22m\u001b[39m                                                                                         \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.414, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Comes up at verify time. Different from RP ID:                                                                        \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
