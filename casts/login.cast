[0.898, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The \u001b[38;2;87;105;247mdeclare module\u001b[39m block at the top of the file (\u001b[38;2;87;105;247msrc/server/session.ts:11-16\u001b[39m) is what lets TypeScript know that       \r\u001b[1B  \u001b[38;2;87;105;247mreq.user\u001b[1C\u001b[39mand\u001b[1C\u001b[38;2;87;105;247mreq.session\u001b[1C\u001b[39mare\u001b[1Clegal\u001b[1Cto\u001b[1Caccess\u001b[1Con\u001b[1Cany\u001b[1CExpress\u001b[1C\u001b[38;2;87;105;247mRequest\u001b[39m.\u001b[1CIt's\u001b[1Cpure\u001b[1Ctype\u001b[1Cinformation\u001b[1C—\u001b[1Cno\u001b[1Cruntime\u001b[1Ceffect.\r\u001b[1B  The runtime behavior is entirely driven by those 10 lines above.                                                      \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;"]
