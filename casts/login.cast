[0.022, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;2;0;0;0m⏺\u001b[1C\u001b[39mGood question, and the framing is slightly off in\u001b[1Ca\u001b[1Cway\u001b[1Cthat's\u001b[1Cworth\u001b[1Csharpening:\u001b[1Cit's\u001b[1Cnot\u001b[1C\"the\u001b[1Cdefault\u001b[1CUI\u001b[1Cto\u001b[1Cshow\"\u001b[1C—\r\u001b[2C\u001b[1Bit's\u001b[1C\"how\u001b[1Cthis\u001b[1Cspecific\u001b[1Ccredential\u001b[1Ccan\u001b[1Cbe\u001b[1Creached\u001b[1Cfrom\u001b[1Cwherever\u001b[1Cthe\u001b[1Cuser\u001b[1Cis\u001b[1Cright\u001b[1Cnow.\"\u001b[1CThe\u001b[1Creason\u001b[1Cthe\u001b[1Cserver\u001b[1Cis\r\u001b[1B  involved at all comes down to one structural fact:                                                                    \r\u001b[1B   \r\u001b[1B  \u001b[1mThe server is the only node that knows about all of a user's credentials.\u001b[22m                                             \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.784, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.963, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.201, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The browser on the laptop you're signing in from has no idea your phone exists, let alone that there's a passkey on   \r\u001b[1B  it.\u001b[1CThe\u001b[1Cphone's\u001b[1Cauthenticator\u001b[1Chas\u001b[1Cno\u001b[1Cidea\u001b[1Cabout\u001b[1Cthe\u001b[1CYubiKey\u001b[1Cin\u001b[1Cyour\u001b[1Cdrawer.\u001b[1CEach\u001b[1Cauthenticator\u001b[1Cknows\u001b[1Conly\u001b[1Cabout\r\u001b[1B  itself. Only the server saw every registration ceremony, so only the server has the cross-device index.               \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[2CThat\u001b[1Cmeans\u001b[1Con\u001b[1Cevery\u001b[1Clogin,\u001b[1Cthe\u001b[1Cserver\u001b[1Chas\u001b[1Cto\u001b[1Ctell\u001b[1Cthe\u001b[1Cbrowser:\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;"]
[0.000, "o", "2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.760, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.963, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.301, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[2m▎\u001b[22m \u001b[3m\"This user has three credentials. Here are their IDs. Credential A is reachable via \u001b[38;2;87;105;247minternal\u001b[39m — if you happen to be \u001b[23m \r\u001b[1B  \u001b[2m▎\u001b[1C\u001b[22m\u001b[3mthe device it lives on, prompt for Touch ID. Credential B is reachable via \u001b[38;2;87;105;247mhybrid\u001b[39m — show a QR so the user can tap \r\u001b[1B\u001b[23m  \u001b[2m▎\u001b[22m \u001b[3mtheir phone. Credential C is reachable via \u001b[38;2;87;105;247musb\u001b[39m — tell them to plug in.\"\u001b[23m                                             \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153"]
[0.000, "o", "m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.661, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.792, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Without that list, the browser on a fresh device literally has nothing to prompt for. It can't discover credentials on\r\u001b[1B   its\u001b[1Cown\u001b[1C—\u001b[1Cthe\u001b[1CWebAuthn\u001b[1CAPI\u001b[1Chas\u001b[1Cno\u001b[1C\"do\u001b[1Cyou\u001b[1Chave\u001b[1Canything\u001b[1Cfor\u001b[1Cexample.com?\"\u001b[1Cquery\u001b[1Cthat\u001b[1Creaches\u001b[1Cacross\u001b[1Cdevices.\u001b[1CThe\u001b[1CRP\r\u001b[1B  server \u001b[3mis\u001b[23m that discovery layer.                                                                                       \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.168, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.545, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  So the server isn't learning \"what UI the user prefers.\" It's learning \u001b[1mstatic properties of each credential\u001b[22m, captured \r\u001b[1B  at\u001b[1Cregistration:\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.417, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.437, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - credential A was born on an iPhone → reachable as \u001b[38;2;87;105;247minternal\u001b[39m on that phone, \u001b[38;2;87;105;247mhybrid\u001b[39m from anywhere else                 \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.290, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1Ccredential\u001b[1CB\u001b[1Cwas\u001b[1Cborn\u001b[1Con\u001b[1Ca\u001b[1CYubiKey\u001b[1C→\u001b[1Creachable\u001b[1Cas\u001b[1C\u001b[38;2;87;105;247musb\u001b[1C\u001b[39mwherever\u001b[1Cthe\u001b[1Ckey\u001b[1Cis\u001b[1Cplugged\u001b[1Cin\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                                                                                                                     \r\u001b[1B\u001b[38;2;153;153;153m───────────────────────────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
