[0.001, "o", "\u001b[?2026h\u001b[2;40r\u001b[2;40r\u001b[62;120s\u001b[39S\u001b[1;62H\u001b[K\u001b[2;40r\u001b[s\u001b[40;62H\"receipt-design.md\"\u001b[1;40r\u001b[40;81H\u001b[?25l\u001b[?2026l 81L, 3278B"]
[0.011, "o", "\u001b[1;62H\u001b[38;5;130m  1 \u001b(B\u001b[m\u001b[35m# Receipt Parser   \u001b[1;83H\u2014\u001b[C Design\u001b[2;62H\u001b[38;5;130m  2 \u001b[3;62H  3 \u001b(B\u001b[m\u001b[35m## Goal\u001b[4;62H\u001b[38;5;130m  4 \u001b[5;62H  5 \u001b[39mBuild a TypeScript module that takes a receipt image an\u001b[6;62H\u001b[38;5;130m    \u001b[39md returns structured data: store name, date, line items\u001b[7;62H\u001b[38;5;130m    \u001b[39m (with prices and categories), tax, and total. This is \u001b[8;62H\u001b[38;5;130m    \u001b[39mthe foundation that the rest of the web app will build \u001b[9;62H\u001b[38;5;130m    \u001b[39mon.\u001b[10;62H\u001b[38;5;130m  6 \u001b[11;62H  7 \u001b(B\u001b[m\u001b[35m## Approach\u001b[12;62H\u001b[38;5;130m  8 \u001b[13;62H  9 \u001b[39mWe'll use Claude's vision capability to read receipt im\u001b[14;62H\u001b[38;5;130m    \u001b[39mages. Rather than traditional OCR + hand-written parsin\u001b[15;62H\u001b[38;5;130m    \u001b[39mg rules, we send the image directly to Claude and ask i\u001b[16;62H\u001b[38;5;130m    \u001b[39mt to return JSON matching our schema. This handles the \u001b[17;62H\u001b[38;5;130m    \u001b[39mhuge variety of receipt formats without writing per-sto\u001b[18;62H\u001b[38;5;130m    \u001b[39mre parsers.\u001b[19;62H\u001b"]
[0.0, "o", "[38;5;130m 10 \u001b[20;62H 11 \u001b(B\u001b[m\u001b[35m### Why Claude vision over OCR libraries?\u001b[21;62H\u001b[38;5;130m 12 \u001b[22;62H 13 -\u001b[39m Receipts vary wildly in layout, font, and quality. Tr\u001b[23;62H\u001b[38;5;130m    \u001b[39maditional OCR (Tesseract, etc.) gives raw text that sti\u001b[24;62H\u001b[38;5;130m    \u001b[39mll needs complex parsing.\u001b[25;62H\u001b[38;5;130m 14 -\u001b[39m Claude can interpret the visual layout, handle wrinkl\u001b[26;62H\u001b[38;5;130m    \u001b[39med/faded receipts, and output structured data in one st\u001b[27;62H\u001b[38;5;130m    \u001b[39mep.\u001b[28;62H\u001b[38;5;130m 15 -\u001b[39m It can also infer categories (e.g. \"bananas\"   \u001b[28;113H\u2192\u001b[28;116H\"Groc\u001b[29;62H\u001b[38;5;130m    \u001b[39meries\") which would otherwise require a separate classi\u001b[30;62H\u001b[38;5;130m    \u001b[39mfication step.\u001b[31;62H\u001b[38;5;130m 16 \u001b[32;62H 17 \u001b(B\u001b[m\u001b[35m## Output Schema\u001b[33;62H\u001b[38;5;130m 18 \u001b[34;62H 19 \u001b(B\u001b[m\u001b[35m```typescript\u001b[35;62H\u001b[38;5;130m 20 \u001b[39minterface ReceiptItem {\u001b[36;62H\u001b[38;5;130m 21 \u001b[39m  name: string;\u001b[36;91H// e.g. \"Bananas\"\u001b[37;62H\u001b[38;5;130m 22 \u001b[39m  price: number;\u001b[37;9"]
[0.0, "o", "1H// e.g. 1.29\u001b[38;62H\u001b[38;5;130m 23 \u001b[39m  quantity: number | null;\u001b[39;62H\u001b[38;5;130m 24 \u001b[39m  category: string;      // e.g. \"Groceries\"\u001b[40;103H1,1\u001b[40;117HTop\u001b[1;66H\u001b[?12l\u001b[?25h"]
