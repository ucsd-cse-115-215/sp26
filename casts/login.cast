[0.574, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1mresidentKey: \"required\"\u001b[1C\u001b[22m\u001b[39mon\u001b[1Cregistration.\u001b[1CWithout\u001b[1Cthis,\u001b[1Csome\u001b[1Cauthenticators\u001b[1Cwould\u001b[1Ccreate\u001b[1Ca\u001b[1Cnon-discoverable\r\u001b[1B  credential and our \u001b[38;2;87;105;247mallowCredentials: []\u001b[39m login flow would fail to find it.                                             \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
