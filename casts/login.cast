[0.774, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[13C\u001b[21A─\u001b[1C┬\u001b[17C─\u001b[3C┬\r\u001b[5C\u001b[1B Value\u001b[2C \u001b[1C│\u001b[1C   Wha\u001b[2Cit means \u001b[3C│\u001b[30C  Typical source\r\u001b[13C\u001b[1B─\u001b[1C┼\u001b[17C─\u001b[3C┼\r\u001b[13C\u001b[1B \u001b[1C│ Built into this\u001b[1C \u001b[1C  │ Touch\u001b[1CID, Face\u001b[1CID, Windows Hello, An\u001b[1Cro\u001b[1Cd fingerprint\r\u001b[13C\u001b[1B \u001b[1C│ device\u001b[10C \u001b[3C│\r\u001b[13C\u001b[1B─\u001b[1C┼\u001b[17C─\u001b[3C┼\r\u001b[13C\u001b[1B \u001b[1C│ Roaming, over USB\u001b[1C  │ YubiKey plugged into\u001b[1Cthe laptop\r\u001b[13C\u001b[1B─\u001b[1C┼\u001b[17C─\u001b[3C┼\r\u001b[13C\u001b[1B \u001b[1C│ Roaming, over NFC\u001b[1C  │ YubiKey tapped to a phone\r\u001b[13C\u001b[1B─\u001b[1C┼\u001b[17C─\u001b[3C┼\r\u001b[13C\u001b[1B \u001b[1C│ Roaming, over\u001b[3C \u001b[1C  │ Legacy; largely superseded by \u001b[38;2;87;105;247mhybrid\r\u001b[13C\u001b[1B\u001b[39m \u001b[1C│ Bluetooth LE\u001b[4C \u001b[3C│\r\u001b[13C\u001b[1B─\u001b[1C┼\u001b[17C─\u001b[3C┼\r\u001b[13C\u001b[1B \u001b[1C│ \"Phone as\u001b[1Ca\u001b[5C \u001b[1C  │ Laptop \u001b[1Chows QR → phone \u001b[1Ccans → phone'\u001b[1C passkey \u001b[1Cigns over\u001b[1CBLE proximity +  \r\u001b[13C\u001b[1B \u001b[1C│ security key\"\u001b[3C \u001b[2C │ cloud relay. This is how Apple/Googl\u001b[1C cross-device passkey sign-in\u001b[1Cworks"]
