[0.007, "o", "\u001b[H\u001b[38;5;130m  1 \u001b(B\u001b[m\u001b[35mimport\u001b[39m fs \u001b[35mfrom\u001b[39m \u001b[32m\"node:fs\"\u001b[39m;\r\n\u001b[38;5;130m  2 \u001b(B\u001b[m\u001b[35mimport\u001b[39m path \u001b[35mfrom\u001b[39m \u001b[32m\"node:path\"\u001b[39m;\r\n\u001b[38;5;130m  3 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[36m{\u001b[39m parseReceipt \u001b[36m}\u001b[39m \u001b[35mfrom\u001b[39m \u001b[32m\"../src/parseReceipt.js\"\u001b[39m;\r\n\u001b[38;5;130m  4 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[35mtype\u001b[39m \u001b[36m{\u001b[39m ParsedReceipt \u001b[36m}\u001b[39m \u001b[35mfrom\u001b[39m \u001b[32m\"../src/types.js\"\u001b[39m;\r\n\u001b[38;5;130m  5 \r\n  6 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[32m\"dotenv/config\"\u001b[39m;\r\n\u001b[38;5;130m  7 \r\n  8 \u001b(B\u001b[m\u001b[36mconst\u001b[39m FIXTURES_DIR = path.\u001b[38;5;130mjoin\u001b[39m(\u001b[35mimport\u001b[39m.\u001b[35mmeta\u001b[39m.\u001b[35mdirname, \u001b[32m\"fixtures\"\u001b[39m);\r\n\u001b[38;5;130m  9 \u001b(B\u001b[m\u001b[36mconst\u001b[39m IMAGE_EXTENSIONS = \u001b[36m[\u001b[32m\".png\"\u001b[39m, \u001b[32m\".jpg\"\u001b[39m, \u001b[32m\".jpeg\"\u001b[39m, \u001b[32m\".webp\"\u001b[39m, \u001b[32m\".gif\"\u001b[36m]\u001b[39m;\r\n\u001b[38;5;130m 10 \r\n 11 interface\u001b[39m \u001b[36mFieldDiff\u001b[39m \u001b[36m{\r\n\u001b[38;5;130m 12 \u001b[39m  \u001b[36mfield\u001b[39m: \u001b[32mstring\u001b[38;5;130m;\r\n 13 \u001b[39m  \u001b[36mexpected\u001b[39m: \u001b[32munknown\u001b[38;5;130m;\r\n 14 \u001b[39m  \u001b[36mactual\u001b[39"]
[0.001, "o", "m: \u001b[32munknown\u001b(B\u001b[m\u001b[38;5;130m;\r\n 15 \u001b(B\u001b[m\u001b[36m}\r\n\u001b[38;5;130m 16 \r\n 17 function\u001b[39m \u001b[36mdiffReceipts\u001b[39m(\r\n\u001b[38;5;130m 18 \u001b(B\u001b[m\u001b[35m  expected\u001b[39m:\u001b[35m \u001b[36mParsedReceipt\u001b[38;5;130m,\r\n 19 \u001b(B\u001b[m\u001b[35m  actual\u001b[39m:\u001b[35m \u001b[36mParsedReceipt\r\n\u001b[38;5;130m 20 \u001b[39m): \u001b[36mFieldDiff\u001b[39m[] \u001b[36m{\r\n\u001b[38;5;130m 21 \u001b[39m  \u001b[36mconst\u001b[39m diffs: \u001b[36mFieldDiff\u001b[39m[] = \u001b[36m[]\u001b[39m;\r\n\u001b[38;5;130m 22 \r\n 23 \u001b[39m  \u001b[34m// Compare top-level scalar fields\r\n\u001b[38;5;130m 24 \u001b[39m  \u001b[38;5;130mfor\u001b[39m (\u001b[36mconst\u001b[39m key \u001b[38;5;130mof\u001b[39m \u001b[36m[\u001b[32m\"store\"\u001b[39m, \u001b[32m\"date\"\u001b[39m, \u001b[32m\"total\"\u001b[39m, \u001b[32m\"subtotal\"\u001b[39m, \u001b[32m\"tax\"\u001b[39m, \u001b[32m\"currency\"\u001b[36m]\u001b[39m \u001b[35mas\u001b[39m \u001b[36mconst\u001b[39m) \u001b[36m{\r\n\u001b[38;5;130m 25 \u001b[39m    \u001b[38;5;130mif\u001b[39m (expected[key] !== actual[key]) \u001b[36m{\r\n\u001b[38;5;130m 26 \u001b[39m      diffs.\u001b[38;5;130mpush\u001b[39m(\u001b[36m{\u001b[39m \u001b[38;5;130mfield\u001b[39m: key, \u001b[38;5;130mexpected\u001b[39m: expected[key], \u001b[38;5;130mactual\u001b[39m: actual[key] \u001b[36m}\u001b[39m);\r\n"]
[0.0, "o", "\u001b[38;5;130m 27 \u001b[39m    \u001b[36m}\r\n\u001b[38;5;130m 28 \u001b[39m  \u001b[36m}\r\n\u001b[38;5;130m 29 \r\n 30 \u001b[39m  \u001b[34m// Compare items count\r\n\u001b[38;5;130m 31 \u001b[39m  \u001b[38;5;130mif\u001b[39m (expected.items.\u001b[38;5;130mlength\u001b[39m !== actual.items.\u001b[38;5;130mlength\u001b[39m) \u001b[36m{\r\n\u001b[38;5;130m 32 \u001b[39m    diffs.\u001b[38;5;130mpush\u001b[39m(\u001b[36m{\r\n\u001b[38;5;130m 33 \u001b[39m      \u001b[38;5;130mfield\u001b[39m: \u001b[32m\"items.length\"\u001b[39m,\r\n\u001b[38;5;130m 34 \u001b[39m      \u001b[38;5;130mexpected\u001b[39m: expected.items.\u001b[38;5;130mlength\u001b[39m,\r\n\u001b[38;5;130m 35 \u001b[39m      \u001b[38;5;130mactual\u001b[39m: actual.items.\u001b[38;5;130mlength\u001b[39m,\r\n\u001b[38;5;130m 36 \u001b[39m    \u001b[36m}\u001b[39m);\r\n\u001b[38;5;130m 37 \u001b[39m  \u001b[36m}\r\n\u001b[38;5;130m 38 \r\n 39 \u001b[39m  \u001b[34m// Compare items pairwise\u001b[40;103H\u001b[39m1,1\u001b[40;117HTop\u001b[1;5H\u001b[?12l\u001b[?25h"]
