[0.101, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1m3. Server (the Relying Party, or RP)\u001b[22m — yes, and worth naming it formally because the spec uses \"RP\" everywhere. The RP\r\u001b[1B   is\u001b[1Cidentified\u001b[1Cby\u001b[1Cits\u001b[1C\u001b[38;2;87;105;247mrpID\u001b[1C\u001b[39m(a\u001b[1Cdomain,\u001b[1Ce.g.\u001b[1C\u001b[38;2;87;105;247mlocalhost\u001b[1C\u001b[39min\u001b[1Cdev,\u001b[1C\u001b[38;2;87;105;247myourapp.com\u001b[1C\u001b[39min\u001b[1Cprod).\u001b[1CCredentials\u001b[1Care\u001b[1Ccryptographically\r\u001b[1B  bound to that RP ID by the authenticator — a credential created for \u001b[38;2;87;105;247myourapp.com\u001b[39m physically cannot be used on          \r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mevilapp.com\u001b[39m,\u001b[1Ceven\u001b[1Cif\u001b[1Cthe\u001b[1Cattacker\u001b[1Chas\u001b[1Cthe\u001b[1Ccredential\u001b[1CID.\u001b[1CThat\u001b[1Cbinding\u001b[1Cis\u001b[1Cenforced\u001b[1Cby\u001b[1Cthe\u001b[1Cauthenticator, not the     \r\r\n\u001b[2Cserver.\r\r\n\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "─────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.442, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mThe \"browser mediates the connection to the server\" part\u001b[22m                                                              \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.417, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.961, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.809, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Right, and more specifically: \u001b[1mthe browser and the server never talk about WebAuthn directly.\u001b[22m The browser gives the web\r\u001b[1B   page\u001b[1CJS\u001b[1Ca\u001b[1Cresult\u001b[1Cobject\u001b[1C(attestation\u001b[1Cor\u001b[1Cassertion),\u001b[1Cand\u001b[1Cthe\u001b[1Cweb\u001b[1Cpage\u001b[1CJSON-encodes\u001b[1Cit\u001b[1Cand\u001b[1CPOSTs\u001b[1Cto\u001b[1Cyour\u001b[1Cserver\u001b[1Chowever\r\u001b[1B   you like. Your server has no idea the user's browser is Chrome or Safari, and doesn't need to.                       \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.156, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.260, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  That's why \u001b[38;2;87;105;247m@simplewebauthn/server\u001b[39m can be pure logic with no network code — it just verifies the bytes the web page    \r\u001b[1B  sent.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "───────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.451, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mThe case that complicates the tidy picture\u001b[22m                                                                            \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.253, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.435, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \"Hybrid\" transport is the edge case that blurs the three-entity model. When you scan a QR on your laptop to sign in   \r\u001b[1B  with\u001b[1Ca\u001b[1Cpasskey\u001b[1Con\u001b[1Cyour\u001b[1Cphone:\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.390, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - The \u001b[1mbrowser\u001b[22m is on the laptop.                                                                                       \r\u001b[1B  -\u001b[1CThe\u001b[1C\u001b[1mauthenticator\u001b[1C\u001b[22mis\u001b[1Con\u001b[1Cthe\u001b[1Cphone.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
