[0.632, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  At upload time in the \u001b[38;2;87;105;247m/scan\u001b[39m handler, compute and store the hash of \u001b[38;2;87;105;247mreq.file.buffer\u001b[39m before handing to the parser.      \r\u001b[1B  Backfill\u001b[1Cis\u001b[1Coptional\u001b[1C—\u001b[1Crecovery\u001b[1Conly\u001b[1Cworks\u001b[1Con\u001b[1Creceipts\u001b[1Cthat\u001b[1Chave\u001b[1Ca\u001b[1Chash,\u001b[1Cwhich\u001b[1Cmeans\u001b[1Conly\u001b[1Creceipts\u001b[1Cuploaded\u001b[1Cafter\u001b[1Cthis\r\u001b[1B   feature ships. Honest with the user: \"recovery requires N receipts originally uploaded after April 2026.\"            \r\u001b[2C\u001b[1B            \r\r\n\u001b[2CRecovery\u001b[1Cendpoint,\u001b[1Croughly:\r\r\n\r\r\n\u001b[2CPOST\u001b[1C/api/auth/recover\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m"]
