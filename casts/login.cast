[0.910, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[32C\u001b[11A┬\u001b[1C─\u001b[14C─\u001b[5C┬\r\u001b[13C\u001b[1BRelation \u001b[10C│\u001b[1C \u001b[1C  Cardinality \u001b[5C│\u001b[23C   Example\r\u001b[32C\u001b[1B┼\u001b[1C─\u001b[14C─\u001b[5C┼\r\u001b[32C\u001b[1B│\u001b[1C\u001b[1mmany-to-many\u001b[22m  \u001b[1C \u001b[1C    │ YubiKey\u001b[1C5 NFC supports \u001b[38;2;87;105;247m{usb, nfc}\u001b[39m. \u001b[38;2;87;105;247minternal\u001b[39m is supported\r\u001b[32C\u001b[1B│\u001b[1C \u001b[14C \u001b[1C    │\u001b[1Cby eve\u001b[1Cy\u001b[1Cplatform \u001b[1Cuthenticator.\r\u001b[2C\u001b[1B├\u001b[29C┼\u001b[1C─\u001b[14C─\u001b[5C┼\u001b[60C┤\r\u001b[2C\u001b[1B│\u001b[1CAuthenticator\u001b[1C↔\u001b[1Ccredential\u001b[2C│\u001b[1C\u001b[1mone-to-many\u001b[1C\u001b[22m(but\u001b[1Csee\u001b[1C│\u001b[1CA\u001b[1CYubiKey\u001b[1Ccan\u001b[1Chold\u001b[1Cmany\u001b[1Ccredentials.\u001b[1CiPhone\u001b[1CSecure\u001b[1CEnclave\u001b[1C│\r\u001b[1B  │                             │  sync)               │  holds many.                                               │   \r\u001b[1B  └─────────────────────────────┴──────────────────────┴─────────────────────────"]
