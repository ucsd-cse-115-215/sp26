[0.376, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A\u001b[36mtransports\u001b[39m:\u001b[1Crow.transports\u001b[1C?\u001b[1Crow.transports.split(\u001b[31m\",\"\u001b[39m)\u001b[1C:\u001b[1C[]\r\u001b[1B  \u001b[32m// writing\u001b[39m                                                                                                            \r\u001b[1B  \u001b[36mtransports\u001b[39m:\u001b[1Ccreds.transports.join(\u001b[31m\",\"\u001b[39m)\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────"]
