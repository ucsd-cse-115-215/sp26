[0.961, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.667, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Binary fields (\u001b[38;2;87;105;247mcredential_id\u001b[39m, \u001b[38;2;87;105;247mpublic_key\u001b[39m, \u001b[38;2;87;105;247muser_handle\u001b[39m) can live as BLOBs in SQLite and base64url strings on the wire. \r\u001b[1B  \u001b[38;2;87;105;247m@simplewebauthn/server\u001b[1C\u001b[39mtakes\u001b[1C\u001b[38;2;87;105;247mUint8Array\u001b[1C\u001b[39min\u001b[1Cits\u001b[1Cv10+\u001b[1CAPI,\u001b[1Cso\u001b[1Cthe\u001b[1Cconversion\u001b[1Chappens\u001b[1Cright\u001b[1Cat\u001b[1Cthe\u001b[1CDB\u001b[1Cboundary:\r\u001b[1B  \u001b[38;2;87;105;247mBuffer.from(row.public_key)\u001b[39m going out, \u001b[38;2;87;105;247mnew Uint8Array(req.body.credentialId_b64url_decoded)\u001b[39m coming in. Storing as BLOB\r\u001b[2C\u001b[1B keeps the DB\u001b[1Chalf\u001b[1Cthe\u001b[1Csize\u001b[1Cof\u001b[1Cbase64\u001b[1Cand\u001b[1Cmakes\u001b[1Cthe\u001b[1Ctypes\u001b[1Chonest.\u001b[30C                     \r\r\n\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
