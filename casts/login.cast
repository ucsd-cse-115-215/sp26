[0.358, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247mtest/auth.test.ts\u001b[39m:\u001b[1Cseven\u001b[1Ctests\u001b[1Ccovering\u001b[1C\u001b[38;2;87;105;247m/me\u001b[39m,\u001b[1C\u001b[38;2;87;105;247m/register/options\u001b[39m,\u001b[1C\u001b[38;2;87;105;247m/login/options\u001b[39m,\u001b[1C\u001b[38;2;87;105;247m/register/verify\u001b[1C\u001b[39m(no-session),\r\u001b[1B  \u001b[38;2;87;105;247m/login/verify\u001b[39m (no-challenge), and \u001b[38;2;87;105;247m/logout\u001b[39m. These assert response shape, set-cookie behavior, and session-row state —  \r\u001b[1B  crypto\u001b[1Cround-trip\u001b[1Cis\u001b[1Cdeferred\u001b[1C(needs\u001b[1Ca\u001b[1Cmock\u001b[1Cauthenticator).\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
