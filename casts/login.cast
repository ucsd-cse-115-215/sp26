[0.159, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - Doesn't survive server restart (users mid-ceremony have to retry).                                                  \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.508, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1CIn-memory\u001b[1Cbreaks\u001b[1Cwith\u001b[1Cmultiple\u001b[1Cserver\u001b[1Cinstances\u001b[1Cunless\u001b[1Cyou\u001b[1Cuse\u001b[1CRedis.\r\u001b[1B  - Adds a dependency.                                                                                                  \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
