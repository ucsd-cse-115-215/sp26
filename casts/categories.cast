[1.135, "o", "\u001b[?2026h\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247mPOST /api/categories\u001b[1C{name}\u001b[1C\u001b[39m→\u001b[1Ctrim,\u001b[1C\u001b[38;2;87;105;247mINSERT OR IGNORE\u001b[39m,\u001b[1Creturn\u001b[1Ccanonical\u001b[1Crow.\u001b[1CIdempotent\u001b[1C—\u001b[1Cexisting\u001b[1Cname\u001b[1Creturns\u001b[1C200\r\u001b[1B  with the canonical-case stored row (preserves original casing per your call on #1).                                   \r\u001b[1B  \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[?2026l"]
