[0.928, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1mpublic_key\u001b[1C\u001b[22m\u001b[39m—\u001b[1Cthe\u001b[1Cpublic\u001b[1Chalf\u001b[1Cof\u001b[1Cthe\u001b[1Ckeypair,\u001b[1Cin\u001b[1CCOSE_Key\u001b[1Cformat\u001b[1C(CBOR-encoded).\u001b[1C\u001b[38;2;87;105;247m@simplewebauthn/server\u001b[1C\u001b[39mhands\u001b[1Cit\u001b[1Cto\r\u001b[1B  you as a \u001b[38;2;87;105;247mUint8Array\u001b[39m; you store it verbatim and hand it back verbatim on verify. Don't try to parse it.                \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
