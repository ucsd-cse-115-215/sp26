[0.782, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The transport set attached to a credential can grow over time. Someone registers on their phone (\u001b[38;2;87;105;247m[\"internal\", \u001b[39m        \r\u001b[1B  \u001b[38;2;87;105;247m\"hybrid\"]\u001b[39m),\u001b[1Clater\u001b[1Csigns\u001b[1Cinto\u001b[1Ctheir\u001b[1Claptop\u001b[1Cvia\u001b[1CQR\u001b[1C—\u001b[1Cthe\u001b[1Claptop\u001b[1Cnow\u001b[1Chas\u001b[1Cthe\u001b[1Ccredential\u001b[1Clocally\u001b[1Ctoo,\u001b[1Cand\u001b[1Cfuture\u001b[1Cresponses\r\u001b[1B   might include different transports.                                                                                  \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[2CYou\u001b[1Chave\u001b[1Ctwo\u001b[1Cchoices:\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;15"]
