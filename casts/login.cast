[0.062, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  1. \u001b[1mPre-auth state\u001b[22m: during registration and login, the server sends the browser a challenge and has to remember it for \r\u001b[1B  ~60\u001b[1Cseconds\u001b[1Cuntil\u001b[1Cthe\u001b[1Cbrowser\u001b[1Creturns\u001b[1Cwith\u001b[1Ca\u001b[1Csigned\u001b[1Cresponse.\u001b[1CYou\u001b[1Cneed\u001b[1Cto\u001b[1Cremember\u001b[1C\"the\u001b[1Cchallenge\u001b[1CI\u001b[1Csent\u001b[1Cto\u001b[1C\u001b[3mthis\r\u001b[1B\u001b[23m  browser tab\" — which means the browser already needs a session cookie even before it's authenticated. So sessions are \r\u001b[2C\u001b[1Bcreated on the\u001b[1Cfirst\u001b[1Cauth\u001b[1Cendpoint\u001b[1Chit,\u001b[1C\u001b[38;2;87;105;247muser_id\u001b[1C\u001b[39mis\u001b[1CNULL,\u001b[1C\u001b[38;2;87;105;247mchallenge\u001b[1C\u001b[39mholds\u001b[1Cthe\u001b[1Cin-flight\u001b[1Cchallenge.                   \r\r\n\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.756, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A2.\u001b[1C\u001b[1mPost-auth state\u001b[22m:\u001b[1Cafter\u001b[1Cverify\u001b[1Csucceeds,\u001b[1Cwe\u001b[1Cset\u001b[1C\u001b[38;2;87;105;247muser_id\u001b[39m,\u001b[1Cclear\u001b[1C\u001b[38;2;87;105;247mchallenge\u001b[39m,\u001b[1Cand\u001b[1Cextend\u001b[1C\u001b[38;2;87;105;247mexpires_at\u001b[39m.\u001b[1CThe\u001b[1Ccookie\u001b[1Cstays\r\u001b[1B  the same; only the row changes.                                                                                       \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
