[0.000, "o", "\u001b[1Cprobably\u001b[1Capplies\u001b[1Cto\u001b[1C`receipts`\u001b[1Citself.\u001b[1CDeferred\u001b[1Cbecause\u001b[1Cnothing\u001b[1Cdepends\u001b[1Con\u001b[1Cit\u001b[1Cyet;\u001b[1Crevisit\u001b[1Cbefo\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m re\u001b[1Canyone's\u001b[1Cdata\u001b[1Cmatters.\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m 307\u001b[1C\u001b[22m \u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m 308\u001b[1C\u001b[22m -\u001b[1C**More\u001b[1Cexplicit\u001b[1Cmid-auth\u001b[1Cstate\u001b[1Crepresentation.**\u001b[1CThe\u001b[1C`sessions`\u001b[1Ctable\u001b[1Cuses\u001b[1Cnullable\u001b[1C`user_id`\u001b[1C/\u001b[1C`cha\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m llenge`\u001b[1Cto\u001b[1Crepresent\u001b[1C\"pre-auth\u001b[1Cceremony\u001b[1Cin\u001b[1Cflight\"\u001b[1Cvs.\u001b[1C\"authenticated\u001b[1Csession.\"\u001b[1CWorks,\u001b[1Cmatches\u001b[1Cthe\u001b[1Cind\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m ustry-standard\u001b[1Cshape,\u001b[1Cbut\u001b[1Cthe\u001b[1Cstate\u001b[1Cmachine\u001b[1Cisn't\u001b[1Cenforced\u001b[1Cby\u001b[1Cthe\u001b[1Cschema\u001b[1C—\u001b[1C`requireAuth`'s\u001b[1Ccheck\u001b[1Con\u001b[1C`r\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m eq.user`\u001b[1Cis\u001b[1Cthe\u001b[1Conly\u001b[1Cthing\u001b[1Ckeeping\u001b[1Ca\u001b[1Chalf-initialized\u001b[1Crow\u001b[1Cfrom\u001b[1Cbeing\u001b[1Ctreated\u001b[1Cas\u001b[1Cauthenticated.\u001b[1CUpgrade\u001b[39m\r\r\n\u001b[5C\u001b"]
[0.000, "o", "[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m \u001b[1Coptions,\u001b[1Ccheapest\u001b[1Cfirst:\u001b[1C(a)\u001b[1Ca\u001b[1C`CHECK`\u001b[1Cconstraint\u001b[1Cmaking\u001b[1Cinvalid\u001b[1Ccombinations\u001b[1Cun-insertable;\u001b[1C(b)\u001b[1Can\u001b[1Ce\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m xplicit\u001b[1C`state`\u001b[1Ccolumn\u001b[1C(`'pending'\u001b[1C|\u001b[1C'authenticated'`)\u001b[1Cwith\u001b[1Ca\u001b[1CCHECK\u001b[1Ctying\u001b[1Cit\u001b[1Cto\u001b[1C`user_id`\u001b[1Cpresence;\u001b[1C(c\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m )\u001b[1Csplit\u001b[1Cinto\u001b[1C`pending_ceremonies`\u001b[1Cand\u001b[1C`sessions`\u001b[1Cas\u001b[1Cseparate\u001b[1Ctables,\u001b[1Crotate\u001b[1Cthe\u001b[1Ccookie\u001b[1Cat\u001b[1Cverify\u001b[1Ctime.\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m \u001b[1C(a)\u001b[1Cis\u001b[1Ca\u001b[1Cone-line\u001b[1Caddition\u001b[1Cwhenever\u001b[1Cwe\u001b[1Cwant\u001b[1Cit.\u001b[1C(c)\u001b[1Cis\u001b[1Cthe\u001b[1Cright\u001b[1Cshape\u001b[1Cif\u001b[1Cwe\u001b[1Cever\u001b[1Cgo\u001b[1Cmulti-process\u001b[1Cor\u001b[39m\r\r\n\u001b[5C\u001b[38;2;51;51;51m\u001b[2m \u001b[4C\u001b[22m \u001b[1Cwant\u001b[1Cthe\u001b[1Cschema\u001b[1Cto\u001b[1Crefuse\u001b[1Cto\u001b[1Crepresent\u001b[1Can\u001b[1Cunauthenticated\u001b[1C\"session.\"\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 309 +\u001b[38;2;51;51;51m                                                           "]
[0.000, "o", "                                           \u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 310 +\u001b[38;2;51;51;51m- **\"Receipt book\" → \"account of receipt books\" migration.** Current model collapses account and recei\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mpt book into a single `users` row (`display_name` = the whimsical name shown in-app and in the keychai\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mn). Cheap because passkey signup is near-instant, so users who want separate sets create separate book\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51ms (= separate passkeys + sessions). We lose cross-book features: no combined search across books, no i\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mn-app switcher, no shared settings, no moving a receipt from one book to another without re-uploading.\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51m Upgrade path when "]
[0.000, "o", "any of those become requirements: add a `books` table (`id`, `user_id`, `display_na\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mme`, `created_at`), move `receipts.user_id` → `receipts.book_id`, demote `users.display_name` to a bar\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mely-surfaced \"profile name,\" rename the user-facing noun from \"receipt book\" (= the account) to \"book\"\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51m (= the child collection). Existing users become one-book users automatically via a backfill. The auth\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51m layer doesn't change. Estimated cost: a day, no data loss. Flagging now so we don't unconsciously des\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mign features that make the migration harder (e.g., encoding the book name into URLs or external IDs in\u001b[49m\u001b[39m\r\r\n\u001b[5C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m "]
[0.000, "o", "    +\u001b[38;2;51;51;51m a way that would break if a user had multiple).                                                      \u001b[49m\u001b[39m\r\r\n\r\r\n\u001b[38;2;215;119;87m✶\u001b[1C\u001b[38;2;245;149;117mS\u001b[38;2;215;119;87mwooping…\u001b[1C\u001b[38;2;102;102;102m(19s\u001b[1C·\u001b[1C↑\u001b[1C774\u001b[1Ctokens)\u001b[39m\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────────────────────────"]
