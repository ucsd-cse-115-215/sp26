[1.853, "o", "\u001b[?2026h\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1m(b) Soft hide:\u001b[1C\u001b[22m\u001b[38;2;87;105;247mactive=0\u001b[39m,\u001b[1Citems\u001b[1Ckeep\u001b[1Cthe\u001b[1Cstring,\u001b[1Ccategory\u001b[1Cjust\u001b[1Cdisappears\u001b[1Cfrom\u001b[1Cthe\u001b[1Ccombobox.\u001b[1CZombie\u001b[1Cstrings\u001b[1Con\u001b[1Citems\r\u001b[1B  remain valid — still renderable, just not suggested. Re-adding the same name \"revives\" it.                            \r\u001b[1B  \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[?2026l"]
[1.933, "o", "\u001b[?2026h\r\u001b[2C\u001b[10A-\u001b[1C\u001b[1m(a) Hard reassign:\u001b[1C\u001b[22mitems\u001b[1Cusing\u001b[1Cthe\u001b[1Cdeleted\u001b[1Ccategory\u001b[1Cget\u001b[1Crewritten\u001b[1Cto\u001b[1C\"Unassigned\".\u001b[1CSuggestion\u001b[1Clist\u001b[1Closes\u001b[1Cit.\u001b[1CClean,\r\u001b[2C\u001b[1Bbut destroys informat\u001b[1Con. \u001b[1C     \u001b[1C   \u001b[1C       \u001b[1C        \u001b[1C   \u001b[1C         \u001b[1C  \u001b[1C             \u001b[1C          \u001b[1C    \u001b[1C     \u001b[1C   \u001b[1C      \r\u001b[2C\u001b[1B- \u001b[1m(b) Soft hide:\u001b[22m \u001b[38;2;87;105;247mactive=0\u001b[39m,\u001b[1Citems\u001b[1Ckeep\u001b[1Cthe\u001b[1Cstring,\u001b[1Ccategory\u001b[1Cjust\u001b[1Cdisappears\u001b[1Cfrom\u001b[1Cthe\u001b[1Ccombobox.\u001b[1CZombie\u001b[1Cstrings\u001b[1Con\u001b[1Citems\r\u001b[2C\u001b[1Bremain valid — still renderable,\u001b[1Cjust\u001b[1Cnot\u001b[2Cuggested. Re-adding the sam\u001b[1C name \"revives\" it.   \u001b[1C      \u001b[1C       \u001b[1C  \u001b[1C     \r\u001b[2C\u001b[1B      \u001b[1C     \u001b[1C \u001b[1C     \u001b[1C           \u001b[1C    \u001b[1C   \u001b[1C          \u001b[1C         \u001b[1C   \u001b[1C    \u001b[1C    \u001b[1C         \u001b[1C   \r\u001b[2C\u001b[1BI'd\u001b[1Cpick\u001b[1C\u001b[1m(b)\u001b[22m.\u001b[1CMatches\u001b[1Cyour\u001b[1C#3\u001b[1Creasoning\u001b[1C(\"if\u001b[1Cyou\u001b[1Cmis-categorize\u001b[1Cand\u001b[1Cswitch,\u001b[1Cthat's\u001b[1Cfine\")\u001b[1Cand\u001b[1Cis\u001b[1Cless\u001b[1Cdestruc"]
[0.000, "o", "tive.\r\u001b[1B  Down side: an item can display a category name that isn't in the suggestion list. Fine — combobox shows current value,\r\u001b[1B  \u001b[1Cuser\u001b[1Ccan\u001b[1Cre-select\u001b[1Canything.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────"]
