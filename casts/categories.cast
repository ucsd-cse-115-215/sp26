[0.405, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1m5. Rename is a different operation than edit.\u001b[22m Editing the category on one item = reassignment. Renaming the category  \r\u001b[1B  globally\u001b[1C(update\u001b[1Call\u001b[1C40\u001b[1Citems\u001b[1Cusing\u001b[1C\"Grocries\"\u001b[1C→\u001b[1C\"Groceries\")\u001b[1Cis\u001b[1Ca\u001b[1Cdifferent\u001b[1Cintent\u001b[1Cand\u001b[1Cprobably\u001b[1Cshouldn't\u001b[1Cbe\u001b[1Cin\u001b[1Cthe\r\u001b[1B  inline combobox at all — defer to a CRUD screen or skip entirely for now.                                             \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────"]
