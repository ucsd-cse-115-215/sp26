[1.454, "o", "\u001b[?2026h\r\u001b[2C\u001b[7ASeed\u001b[1Conly\u001b[1C\u001b[38;2;87;105;247m(\"Unassigned\", active=1, deletable=0)\u001b[1C\u001b[39mon\u001b[1Cempty.\u001b[1CNo\u001b[1Cother\u001b[1Cseed.\r\u001b[2C\u001b[1B    \u001b[1C    \u001b[1C                                     \u001b[1C  \u001b[1C      \u001b[1C  \u001b[1C     \u001b[1C     \r\u001b[2C\u001b[1B\u001b[1mAuto-learn:\u001b[1C\u001b[22mafter\u001b[1C\u001b[38;2;87;105;247minsertReceipt\u001b[1C\u001b[39mand\u001b[1Cafter\u001b[1C\u001b[38;2;87;105;247mupdateReceipt\u001b[1C\u001b[39mitem\u001b[1Cchanges,\u001b[1C\u001b[38;2;87;105;247mINSERT OR IGNORE\u001b[1C\u001b[39mevery\u001b[1Cnon-empty\u001b[1Ccategory\u001b[1Cstring\r\u001b[1B   from the items into \u001b[38;2;87;105;247mcategories\u001b[39m. Runs inside the existing transaction. Trims input; rejects empty → defaults to       \r\u001b[1B  \"Unassigned\".\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────"]
