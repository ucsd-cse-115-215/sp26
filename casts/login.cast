[0.157, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  3. Browser →  POST /api/auth/register/verify  (cookie attached)                                                       \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.411, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[5C\u001b[5AServer:\u001b[4CconsumeSessionChallenge\u001b[1C→\u001b[1Cget\u001b[1Cchallenge,\u001b[1Cverify\u001b[1Csignature\r\u001b[1B                → insertUser → insertCredential                                                                         \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
