[0.482, "o", "\u001b[2A\u001b[34mimport\u001b[C\u001b[39m{\u001b[Ctest,\u001b[Cdescribe,\u001b[Cbefore,\u001b[Cafter\u001b[C}\u001b[C\u001b[34mfrom\u001b[C\u001b[31m\"node:test\"\u001b[39m;\r\n  \u001b[34mimport\u001b[39m assert \u001b[34mfrom\u001b[39m \u001b[31m\"node:assert/strict\"\u001b[39m;                                                                                          \u001b[33;1H   \r\n  test(\u001b[31m\"example\"\u001b[39m, \u001b[33m() =>\u001b[39m {                                                                                                           \u001b[35;3H            \r\n\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[36;132H\n\r\u001b[K\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[36;132H\n\u001b[35;3H\u001b[7m \u001b(B\u001b[m\r\n\u001b[K\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m"]
