[0.004, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[12A-\u001b[1C\u001b[38;2;87;105;247mtest/api.test.ts\u001b[39m:\u001b[1Cevery\u001b[1Creceipt-route\u001b[1Ccall\u001b[1Cnow\u001b[1Cgoes\u001b[1Cthrough\u001b[1C\u001b[38;2;87;105;247mauthFetch\u001b[39m,\u001b[1Cplus\u001b[1Ca\u001b[1Cnew\u001b[1C401-gating\u001b[1Ctest\u001b[1Cfor\r\u001b[2C\u001b[1Bunauthenticated requ\u001b[1Csts.\u001b[1C             \u001b[1C    \u001b[1C   \u001b[1C    \u001b[1C       \u001b[1C          \u001b[1C    \u001b[1C \u001b[1C   \u001b[1C          \u001b[1C    \u001b[1C   \r\u001b[2C\u001b[1B- \u001b[38;2;87;105;247mtest/auth.test.ts\u001b[39m: \u001b[1Ceven\u001b[1Ctests\u001b[1Ccovering\u001b[1C\u001b[38;2;87;105;247m/me\u001b[39m,\u001b[1C\u001b[38;2;87;105;247m/register/options\u001b[39m,\u001b[1C\u001b[38;2;87;105;247m/login/options\u001b[39m,\u001b[1C\u001b[38;2;87;105;247m/register/verify\u001b[1C\u001b[39m(no-session),\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247m/login\u001b[1Cverify\u001b[39m (no-challenge), and \u001b[38;2;87;105;247m/logout\u001b[39m. These assert response shape, set-cookie behavior, and session-row state\u001b[1C—\r\u001b[2C\u001b[1Bcrypto round-trip is deferred\u001b[1C(\u001b[1Ceeds a mock authentica\u001b[1Co\u001b[1C).     \u001b[1C      \u001b[1C          \u001b[1C         \u001b[1C   \u001b[1C           \u001b[1C     \u001b[1C \r\u001b[2C\u001b[1B- \u001b[38;2;87;105;247mpackage.json\u001b[39m test script "]
[0.000, "o", "now runs both files.            \r\u001b[2C\u001b[1B \u001b[1C            \u001b[1C    \u001b[1C      \u001b[1C   \u001b[1C    \u001b[1C    \u001b[1C      \r\u001b[2C\u001b[1BDeferred\u001b[1Cfor\u001b[1Clater:\u001b[1Cfull\u001b[1Cregister\u001b[1C+\u001b[1Clogin\u001b[1Cround-trip\u001b[1Cusing\u001b[1Ca\u001b[1Cmock\u001b[1Cauthenticator\u001b[1C(e.g.\u001b[1C\u001b[38;2;87;105;247m@simplewebauthn/server\u001b[39m's\u001b[1Cverify\r\u001b[1B  with a synthesized attestation), and the frontend \u001b[38;2;87;105;247m@simplewebauthn/browser\u001b[39m wiring.                                     \r\u001b[1B   \r\u001b[1B\u001b[38;2;102;102;102m✻\u001b[39m \u001b[38;2;102;102;102mCooked for 4m 42s\u001b[39m                                                                                                     \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
