[0.606, "o", "\u001b[2A5.\u001b[C\u001b[1mHow to run the tests\u001b[C\u001b(B\u001b[m\u2014\u001b[C\u001b[38;5;105mnpx tsx --test test/api.test.ts\u001b[39m,\u001b[Cwhat\u001b[Cthey\u001b[Ccover,\u001b[Cand\u001b[Cthat\u001b[Cthey\u001b[Cuse\u001b[C\u001b[38;5;105m:memory:\u001b[C\u001b[39mSQLite\u001b[Cso\u001b[Cthere's\u001b[Cno\r\n  cleanup.                                                                                                                          \u001b[33;1H   \u001b[35;1H\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[7m \u001b(B\u001b[m           \r\n\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[36;1H\u001b[2S\u001b[35;2H\u001b[1K\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241mINSERT\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[K\r\n\u001b[K\u001b[33;3H"]
