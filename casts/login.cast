[0.467, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[38;2;87;105;247m\u001b[1musername\u001b[22m\u001b[39m — the only human-facing identifier. It's what we show in the UI and pass to \u001b[38;2;87;105;247mstartAuthentication\u001b[39m when we    \r\u001b[1B  want\u001b[1Cto\u001b[1Clook\u001b[1Cup\u001b[1Cthat\u001b[1Cuser's\u001b[1Ccredentials.\u001b[1CUnique\u001b[1Cfor\u001b[1Cobvious\u001b[1Creasons.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────"]
