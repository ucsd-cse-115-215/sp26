[0.0, "o", "display\u001b[C+\u001b[Cinline\u001b[Ceditable\u001b[Cfields\u001b[Cwith\u001b[Cautosave\u001b[Con\u001b[Cblur\u001b[C(yellow\u001b[Cwhile\u001b[Csaving,\u001b[Cgreen\u001b[Con\u001b[10;1H   saved)                                                                                                                           \u001b[11;3H-\u001b[C\u001b[38;5;105mclient/src/lib/imageStore.ts\u001b[C\u001b[39m\u2014\u001b[CIndexedDB\u001b[Cwrapper\u001b[Cfor\u001b[Csaving/loading\u001b[Creceipt\u001b[Cimage\u001b[Cblobs\r\n \u001b[C- \u001b[38;5;105mclient/src/App.css\u001b[39m \u2014 plain CSS\u001b[Cfor all\u001b[Cthe\u001b[Cabove\r\n          \u001b[C  \u001b[C         \u001b[C   \u001b[C       \u001b[C   \u001b[C        \u001b[C  \u001b[C  \u001b[14;3H\u001b[1mScripts:\u001b[15;3H\u001b(B\u001b[m-\u001b[C\u001b[38;5;105mnpm run dev:server\u001b[39m \u2014 starts Express on\u001b[C\u001b[38;5;105m:3001\u001b[16;3H\u001b[39m-\u001b[C\u001b[38;5;105mnpm run dev:client\u001b[39m \u2014 starts Vite\u001b[Con\u001b[C\u001b[38;5;105m:5173\u001b[C\u001b[39mwith\u001b[Cproxy\u001b[18;3HAll types are shared from \u001b[38;5;105msrc/types.ts\u001b[C\u001b[39m\u2014\u001b[Cno\u001b[Cduplication\u001b[Cbetween\u001b[Cclient\u001b[Cand\u001b[Cserver.\u001b[CYou\u001b[Ccan\u001b[Ctry\u001b[Cit\u001b[Cby\u001b[Crunning\u001b[Cboth\u001b[Cdev\u001b[Ccommands\u001b[Cin\u001b[19;3Ht"]
[0.0, "o", "wo\u001b[Cterminals\u001b[Cand\u001b[Copening\u001b[C\u001b[38;5;105mhttp://localhost:5173\u001b[39m.\r\n \u001b[C                    \r\n\u001b[38;5;241m\u273b\u001b[39m \u001b[38;5;241mCrunched for 3m 38s\u001b[22;6H\u001b[39m                                   \r\n\u001b[38;5;248m\u001b[48;5;255m\u276f \u001b[38;5;16mSorry, I realized I don't understand the point of the separate Vite server. I may be a Vite noob. Help?\u001b[39m                           \u001b[24;6H\u001b[49m                                               \r\n\u001b[38;5;16m\u23fa\u001b[C\u001b[39mIn\u001b[Cdevelopment, you're running two servers:                                                                                \u001b[26;6H                                                \u001b[27;3H-\u001b[C\u001b[1mExpress on :3001\u001b(B\u001b[m \u2014 your API (\u001b[38;5;105m/api/receipts\u001b[39m,\u001b[Cetc.)\u001b[28;3H-\u001b[C\u001b[1mVite on :5173\u001b[C\u001b(B\u001b[m\u2014\u001b[Cserves\u001b[Cyour\u001b[CReact\u001b[Ccode\u001b[Cwith\u001b[Chot\u001b[Cmodule\u001b[Creplacement\u001b[C(HMR)\u001b[30;1H \u001b[CVite's dev server is what giv\u001b[Cs you the fast feedback loop:\u001b[Cyou\u001b[Cedit\u001b[Ca\u001b[C\u001b[38;5;105m.tsx\u001b[C\u001b[39mfile,\u001b[Csave,\u001b[Cand\u001b[Cthe"]
