[0.121, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The existing API test file is entirely broken by auth. I'll add a test helper that seeds a user + session directly in \r\u001b[1B  the\u001b[1CDB\u001b[1Cand\u001b[1Creturns\u001b[1Cthe\u001b[1Ccookie\u001b[1Cstring\u001b[1Cto\u001b[1Cattach:\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1B\u001b[34mfunction\u001b[33m \u001b[39mseedAuthedSession(db):\u001b[1C{\u001b[1CuserId:\u001b[1C\u001b[36mnumber\u001b[39m;\u001b[1Ccookie:\u001b[1C\u001b[36mstring\u001b[1C\u001b[39m}\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────"]
