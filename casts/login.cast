[0.857, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mAt registration\u001b[22m, the authenticator tells the browser what it supports, the browser hands it to you in the response.   \r\u001b[1B  \u001b[38;2;87;105;247m@simplewebauthn/server\u001b[1C\u001b[39msurfaces\u001b[1Cit\u001b[1Cas\u001b[1C\u001b[38;2;87;105;247mregistrationInfo.credential.transports\u001b[1C\u001b[39m(typed\u001b[1C\u001b[38;2;87;105;247mAuthenticatorTransportFuture[]\u001b[39m).\r\u001b[1B  You store it.                                                                                                         \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[2C\u001b[1mAt\u001b[1Clogin\u001b[22m,\u001b[1Cyou\u001b[1Cecho\u001b[1Cit\u001b[1Cback\u001b[1Cin\u001b[1C\u001b[38;2;87;105;247mallowCredentials\u001b[39m:\r\r\n\r\r\n\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
