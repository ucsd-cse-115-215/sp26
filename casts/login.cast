[0.004, "o", "\u001b[?2026h\u001b[113D\u001b[3B\r\u001b[13A\u001b[48;2;240;240;240m\u001b[38;2;175;175;175m❯ \u001b[38;2;0;0;0mOK this is a good discussion. Here's what I'm thinking right now:\u001b[39m                                                     \r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;0;0;0m- Write the clever recovery idea into an \"ideas\" section of the design doc. Not worth the distraction, but fun to \u001b[39m    \r\u001b[1B  \u001b[38;2;0;0;0mthink about\u001b[39m                                                                                                           \r\u001b[1B  \u001b[38;2;0;0;0m- Let's do the username-less flow with the generated nicknames and the “receipt book” concept\u001b[39m                         \r\u001b[1B  \u001b[38;2;0;0;0m- Don't store counter. I don't like storing extra data\u001b[39m                                                                \r\u001b[1B  \u001b[38;2;0;0;0m- Don't store the transports. I am opinionated about this and think it should be the user agent's pro"]
[0.000, "o", "blem not my \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mserver's problem\u001b[39m                                                                                                      \r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;0;0;0mWrite those decisions into the design document, then present me the schema and planned update for the database.\u001b[39m       \r\u001b[2C\u001b[1B\u001b[49m     \u001b[1C     \u001b[1C         \u001b[1C    \u001b[1C   \u001b[1C      \u001b[1C         \u001b[1C    \u001b[1C       \u001b[1C  \u001b[1C   \u001b[1C      \u001b[1C   \u001b[1C       \u001b[1C      \u001b[1C   \u001b[1C   \u001b[1C          \r\u001b[1B\u001b[38;2;215;119;87m·\u001b[39m \u001b[38;2;215;119;87mHerding… \u001b[39m                                                                                                             \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
