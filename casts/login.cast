[0.125, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1mtransports\u001b[1C\u001b[22m\u001b[39m—\u001b[1Chints\u001b[1Cthe\u001b[1Cbrowser\u001b[1Cgives\u001b[1Cyou\u001b[1Cabout\u001b[1Chow\u001b[1Cthis\u001b[1Ccredential\u001b[1Cis\u001b[1Creachable:\u001b[1C\u001b[38;2;87;105;247m\"internal\"\u001b[1C\u001b[39m(platform\r\u001b[1B  authenticator), \u001b[38;2;87;105;247m\"hybrid\"\u001b[39m (phone-as-a-key via QR/bluetooth), \u001b[38;2;87;105;247m\"usb\"\u001b[39m, \u001b[38;2;87;105;247m\"nfc\"\u001b[39m, \u001b[38;2;87;105;247m\"ble\"\u001b[39m. You echo these back in               \r\u001b[1B  \u001b[38;2;87;105;247mallowCredentials\u001b[1C\u001b[39mso\u001b[1Cthe\u001b[1Cbrowser\u001b[1Cshows\u001b[1Cthe\u001b[1Cright\u001b[1CUI\u001b[1C(e.g.\u001b[1C\"Use\u001b[1Ca\u001b[1Cdevice\u001b[1Cnearby\"\u001b[1Cvs.\u001b[1C\"Use\u001b[1CTouch\u001b[1CID\").\u001b[1CCSV\u001b[1Cis\u001b[1Cfine\u001b[1C—\u001b[1Cit's\r\u001b[1B   advisory, not security-critical.                                                                                     \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────"]
[0.000, "o", "────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.839, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.691, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1mbacked_up\u001b[1C\u001b[22m\u001b[39m—\u001b[1Cfrom\u001b[1Cthe\u001b[1C\u001b[38;2;87;105;247mBE\u001b[39m/\u001b[38;2;87;105;247mBS\u001b[1C\u001b[39mflags\u001b[1Cin\u001b[1Cthe\u001b[1Cauthenticator\u001b[1Cdata.\u001b[1CTells\u001b[1Cyou\u001b[1Cwhether\u001b[1Cthis\u001b[1Ccredential\u001b[1Cis\u001b[1Csynced\u001b[1Cto\u001b[1Ca\u001b[1Ccloud\r\u001b[1B  (iCloud Keychain, Google) or device-bound (YubiKey). Not required for the protocol, but useful if you later want to   \r\u001b[1B  say\u001b[1C\"you\u001b[1Conly\u001b[1Chave\u001b[1Cone\u001b[1Cdevice-bound\u001b[1Ckey,\u001b[1Cadd\u001b[1Ca\u001b[1Cbackup.\"\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;1"]
