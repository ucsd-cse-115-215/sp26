[0.654, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.073, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[1mWebAuthn\u001b[22m: the JS API between the \u001b[3mweb page\u001b[23m and the \u001b[3mbrowser\u001b[23m. \u001b[38;2;87;105;247mnavigator.credentials.create()\u001b[39m / \u001b[38;2;87;105;247m.get()\u001b[39m. This is what    \r\u001b[1B  your\u001b[1Cclient\u001b[1Ccode\u001b[1Ccalls.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────"]
[0.000, "o", "────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.888, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.284, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mCTAP2\u001b[1C\u001b[22m(Client\u001b[1CTo\u001b[1CAuthenticator\u001b[1CProtocol):\u001b[1Cthe\u001b[1Cwire\u001b[1Cprotocol\u001b[1Cbetween\u001b[1Cthe\u001b[1C\u001b[3mbrowser\u001b[1C\u001b[23mand\u001b[1C\u001b[3mroaming authenticators\u001b[23m.\u001b[1CRuns\r\u001b[1B  over USB HID, NFC, BLE, or the \"hybrid\" QR+BLE+cloud tunnel.                                                          \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.678, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.060, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  For platform authenticators the browser doesn't use CTAP2 — it calls OS APIs (Keychain on macOS, WebAuthn APIs on     \r\u001b[1B  Windows,\u001b[1Cetc.).\u001b[1CBut\u001b[1Cfor\u001b[1Canything\u001b[1Cexternal,\u001b[1Cit's\u001b[1CCTAP2.\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1BSo the picture\u001b[1Cis:\u001b[77C                     \r\r\n\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.745, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5Aweb\u001b[1Cpage\u001b[2C──WebAuthn\u001b[1CJS\u001b[1CAPI──▶\u001b[2Cbrowser\u001b[2C──CTAP2\u001b[1C/\u001b[1COS\u001b[1CAPI──▶\u001b[2Cauthenticator\r\u001b[1B                                      │                                                                                 \r\u001b[1B   \u001b[35C▼\r\u001b[1B                                 server (RP)                                                                            \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
