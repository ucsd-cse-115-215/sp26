[0.167, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A2.\u001b[1C\u001b[1mIt fights your #6 direction.\u001b[1C\u001b[22mIf\u001b[1Cthe\u001b[1Cmodel\u001b[1Cfreely\u001b[1Cproposes\u001b[1Ccategories\u001b[1Cduring\u001b[1Cparse,\u001b[1Ca\u001b[1Cstrict\u001b[1CFK\u001b[1Cforces\u001b[1Ca\r\u001b[1B  lookup-or-insert dance on every item insert (\u001b[38;2;87;105;247mINSERT INTO categories ... ON CONFLICT DO NOTHING; SELECT id; INSERT INTO\r\u001b[1B\u001b[39m  \u001b[38;2;87;105;247m receipt_items ...\u001b[39m).\u001b[1CWith\u001b[1Ca\u001b[1Cplain\u001b[1Cstring,\u001b[1C\u001b[38;2;87;105;247minsertReceipt\u001b[1C\u001b[39min\u001b[1C\u001b[38;2;87;105;247msrc/server/db.ts:50\u001b[1C\u001b[39mstays\u001b[1Cas-is,\u001b[1Cand\u001b[1Ca\u001b[1Cseparate\u001b[1Ctrigger\u001b[1Cor\r\u001b[1B  post-insert pass populates the categories table. The string-on-item approach treats category as an \u001b[3mopen vocabulary\u001b[23m    \r\u001b[2C\u001b[1Bwith a curator\u001b[1C(the\u001b[1Ccategories\u001b[1Ctable),\u001b[1Cwhich\u001b[1Cmatches\u001b[1Cwhat\u001b[1Cyou're\u001b[1Cdescribing.\u001b[19C                     \r\r\n\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
