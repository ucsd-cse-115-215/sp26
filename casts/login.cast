[0.526, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Same single-table shape we have, but the state machine is made explicit with a column, and the cross-column invariant \r\u001b[1B  is\u001b[1Cenforced\u001b[1Cby\u001b[1Ca\u001b[1C\u001b[38;2;87;105;247mCHECK\u001b[1C\u001b[39mconstraint.\u001b[1CBad\u001b[1Cstates\u001b[1Care\u001b[1Crejected\u001b[1Cby\u001b[1Cthe\u001b[1CDB,\u001b[1Cnot\u001b[1Ctrusted\u001b[1Cto\u001b[1Cthe\u001b[1Ccode.\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1BPros over what\u001b[1Cwe\u001b[1Chave:\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────"]
