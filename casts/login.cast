[0.711, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1CNo\u001b[1C\u001b[38;2;87;105;247mfailed_login_attempts\u001b[1C\u001b[39m/\u001b[1Clockout\u001b[1C—\u001b[1Cpasskeys\u001b[1Cdon't\u001b[1Cneed\u001b[1Cit;\u001b[1Cthere's\u001b[1Cnothing\u001b[1Cto\u001b[1Cbrute-force\u001b[1Cserver-side.\r\u001b[1B  - No email verification table.                                                                                        \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
