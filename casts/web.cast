[0.0, "o", " cents** to avoid floating-point rounding errors (e.g. `$12.49` \u001b[39m\u001b[49m\u001b[K\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m\u2192\u001b[39m\u001b[49m\u001b[36;132H\n\u001b[35;118H\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m `1249`)\u001b[39m\u001b[49m\u001b[36;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51m. The AI parser returns decimal dollars, so we convert at\u001b[39m\u001b[49m\u001b[K\u001b[?2026l\u001b[?2026h\r\u001b[2S\u001b[34;69H\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m the save boundary: `Math.round(dollars * 100)`.         \u001b[39m\u001b[49m\u001b[35;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  73 +\u001b[38;2;51;51;51m                                                                                                                  \u001b[39m\u001b[49m\u001b[K\u001b[36;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  74 +\u001b[38;2;51;51;51mNo receipt images are stored \u001b[39m\u001b[49m\u001b[K\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m\u2014\u001b[39m\u001b[49m\r\u001b[4S\u001b[32;42H\u001b[38;2;51;51;51m\u001b[48;2;220;255;220m only extracted and user-corrected data.                                            \u001b[39m\u001b[49m\u001b[33;5H\u001b[1K\u001b[C\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m "]
