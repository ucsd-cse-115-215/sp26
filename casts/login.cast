[0.270, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  And one legacy note you'll see in the library output: registration options from \u001b[38;2;87;105;247m@simplewebauthn/server\u001b[39m include both   \r\u001b[1B  \u001b[38;2;87;105;247mresidentKey: \"required\"\u001b[1C\u001b[39m\u001b[3mand\u001b[1C\u001b[23mthe\u001b[1Colder\u001b[1Cboolean\u001b[1C\u001b[38;2;87;105;247mrequireResidentKey: true\u001b[39m.\u001b[1CThat's\u001b[1Cbackwards-compat\u001b[1Cfor\u001b[1Cauthenticators\r\u001b[1B  that only understand the pre-L2 field. Safe to ignore; both mean the same thing.                                      \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;215;119;87m✻\u001b[1CRoosting…\u001b[1C\u001b[38;2;102;102;102m(29s\u001b[1C·\u001b[1C↓\u001b[1C644\u001b[1Ctokens)\u001b[39m\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;1"]
