[0.715, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[11A-\u001b[1C\u001b[38;2;87;105;247mcategories(name TEXT PRIMARY KEY COLLATE NOCASE, active INTEGER DEFAULT 1)\u001b[39m,\u001b[1Cseeded\u001b[1Conce\u001b[1Con\u001b[1Cempty.\r\u001b[4C\u001b[1BPrompt reads \u001b[38;2;87;105;247ms\u001b[1Ced ∪ DISTINCT(item.category)\u001b[39m minus \u001b[38;2;87;105;247mactive=0\u001b[39m rows — categories table\u001b[1Cis authoritative\u001b[1Conly\u001b[1Cfor\u001b[1Cthe\r\u001b[2C\u001b[1Bhide list.    \u001b[1C                              \u001b[1C     \u001b[1C        \u001b[1C    \u001b[1C \u001b[1C          \u001b[1C     \u001b[1C  \u001b[1C             \u001b[1C    \u001b[1C   \u001b[1C   \r\u001b[2C\u001b[1B- API: \u001b[38;2;87;105;247mGET /api/categories\u001b[1C\u001b[39m(returns\u001b[1Csuggestion\u001b[1Clist),\u001b[1C\u001b[38;2;87;105;247mPOST\u001b[1C\u001b[39m(explicit\u001b[1Ccreate),\u001b[1C\u001b[38;2;87;105;247mDELETE\u001b[1C\u001b[39m(soft).\u001b[1CThe\u001b[1Citem\u001b[1CPUT\u001b[1Cstays\u001b[1Cas-is\r\u001b[2C\u001b[1Bbut normalizes input.     \u001b[1C        \u001b[1C          \u001b[1C      \u001b[1C    \u001b[1C         \u001b[1C        \u001b[1C      \u001b[1C       \u001b[1C   \u001b[1C    \u001b[1C   \u001b[1C     \u001b[1C     \r\u001b[2C\u001b[1B- UI co\u001b[1Cbobox has two\u001b[1Caffordances:\u001b[1Cpick\u001b[1C(sends\u001b[1Cthe\u001b[1Ccanonical\u001b[1Cname)\u001b[1Cvs\u001b[1Ccreate\u001b[1C("]
