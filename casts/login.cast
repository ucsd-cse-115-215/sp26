[0.191, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1CA\u001b[1Cfree-form\u001b[1C\"nickname\"\u001b[1C—\u001b[1C\"Joe's\u001b[1Cphone,\"\u001b[1C\"work\u001b[1Caccount.\"\u001b[1CNot\u001b[1Cvalidated,\u001b[1Cnot\u001b[1Cunique,\u001b[1Cnot\u001b[1Cused\u001b[1Cfor\u001b[1Clogin.\u001b[1CPure\u001b[1Ckeychain\r\u001b[1B   sugar.                                                                                                               \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
