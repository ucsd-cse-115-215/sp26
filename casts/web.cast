[0.012, "o", "\u001b[H\u001b[38;5;130m  1 \u001b(B\u001b[m\u001b[35mimport\u001b[39m express, \u001b[36m{\u001b[39m \u001b[35mtype\u001b[39m \u001b[32mRequest\u001b[39m, \u001b[35mtype\u001b[39m \u001b[32mResponse\u001b[39m \u001b[36m}\u001b[39m \u001b[35mfrom\u001b[39m \u001b[32m\"express\"\u001b[39m;\r\n\u001b[38;5;130m  2 \u001b(B\u001b[m\u001b[35mimport\u001b[39m multer \u001b[35mfrom\u001b[39m \u001b[32m\"multer\"\u001b[39m;\r\n\u001b[38;5;130m  3 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[36m{\u001b[39m tmpdir \u001b[36m}\u001b[39m \u001b[35mfrom\u001b[39m \u001b[32m\"node:os\"\u001b[39m;\r\n\u001b[38;5;130m  4 \u001b(B\u001b[m\u001b[35mimport\u001b[39m fs \u001b[35mfrom\u001b[39m \u001b[32m\"node:fs\"\u001b[39m;\r\n\u001b[38;5;130m  5 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[35mtype\u001b[39m Database \u001b[35mfrom\u001b[39m \u001b[32m\"better-sqlite3\"\u001b[39m;\r\n\u001b[38;5;130m  6 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[35mtype\u001b[39m \u001b[36m{\u001b[39m ParsedReceipt \u001b[36m}\u001b[39m \u001b[35mfrom\u001b[39m \u001b[32m\"../types.js\"\u001b[39m;\r\n\u001b[38;5;130m  7 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[36m{\u001b[39m parseReceipt \u001b[36m}\u001b[39m \u001b[35mfrom\u001b[39m \u001b[32m\"../parseReceipt.js\"\u001b[39m;\r\n\u001b[38;5;130m  8 \u001b(B\u001b[m\u001b[35mimport\u001b[39m \u001b[36m{\u001b[39m createDb, insertReceipt, getReceipt, getAllReceipts, updateReceipt, deleteReceipt \u001b[36m}\u001b[39m \u001b[35mfrom\u001b[39m \u001b[32m\"./db.js\"\u001b[39m;\r\n\u001b[38;5;130m  9 \u001b(B\u001b[m\u001b[35mimport\u001b[39m "]
