[0.121, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[7A\u001b[38;2;0;0;0m⏺\u001b[1C\u001b[39mThat's genuinely clever and I hadn't considered it. It's\u001b[1Ca\u001b[1C\"something\u001b[1Cyou\u001b[1Chave\"\u001b[1Crecovery\u001b[1Cfactor\u001b[1Cwhere\u001b[1Cthe\u001b[1C\u001b[3msomething\u001b[1C\u001b[23mis\r\u001b[1B   the original image files, which you already have cryptographic fingerprints for. You don't\u001b[1Chave\u001b[1Cto\u001b[1Ccollect\u001b[1Canything\r\u001b[2C\u001b[1Bnew\u001b[1C—\u001b[1Cthe\u001b[1Crecovery\u001b[1Ccapability\u001b[1Cis\u001b[1Clatent\u001b[1Cin\u001b[1Cdata\u001b[1Cyou're\u001b[1Calready\u001b[1Cstoring.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                  "]
[0.000, "o", "                                                                                                   \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.191, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.219, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  A few things worth thinking through before committing, because this kind of recovery scheme is novel enough that      \r\u001b[1B  there's\u001b[1Cno\u001b[1Cprior\u001b[1Cart\u001b[1Cto\u001b[1Cinherit\u001b[1Ca\u001b[1Cthreat\u001b[1Canalysis\u001b[1Cfrom.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.377, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mHash choice determines the security model\u001b[22m                                                                             \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.348, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The two options point in very different directions:                                                                   \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.016, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.964, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.538, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[1mByte-exact hash (SHA-256 of the uploaded file).\u001b[22m Proof means \"I have the \u001b[3mexact same file\u001b[23m that was uploaded.\"         \r\u001b[1B  Re-photographing\u001b[1Cthe\u001b[1Cphysical\u001b[1Creceipt\u001b[1Cwon't\u001b[1Cmatch\u001b[1C—\u001b[1Ccompression,\u001b[1Cangle,\u001b[1Csensor\u001b[1Cnoise\u001b[1Call\u001b[1Cdiffer.\u001b[1CThis\u001b[1Cties\u001b[1Crecovery\u001b[1Cto\r\u001b[1B   file-level possession, which is what you want.                                                                       \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.425, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.335, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mPerceptual hash (pHash, dHash).\u001b[1C\u001b[22mMatches\u001b[1Cvisually\u001b[1Csimilar\u001b[1Cimages.\u001b[1CMuch\u001b[1Cweaker:\u001b[1Can\u001b[1Cattacker\u001b[1Cwho\u001b[1Cfinds\u001b[1Cthe\u001b[1Cphysical\r\u001b[1B  receipt in your recycling can re-photograph it and match.                                                             \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.630, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.560, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Go with byte-exact. The recovery factor then reads as \"the user kept the original image files from when they          \r\u001b[1B  uploaded.\"\u001b[1CThat's\u001b[1Ca\u001b[1Creasonable\u001b[1Cassumption\u001b[1Cfor\u001b[1Canyone\u001b[1Cwith\u001b[1Ca\u001b[1Cnormal\u001b[1Cphone\u001b[1CPhotos\u001b[1Clibrary\u001b[1C—\u001b[1Cphotos\u001b[1Cstick\u001b[1Caround\u001b[1Cby\r\u001b[1B  default.                                                                                                              \r\u001b[2C\u001b[1B            \r\r\n\u001b[2C\u001b[1mThreshold\u001b[1Cis\u001b[1Cthe\u001b[1Cother\u001b[1Clever\u001b[22m\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.404, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.313, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  N = 1 is too weak. Anyone who gets hold of one leaked image could recover. N = 5 or 10 is robust — the coincidence of \r\u001b[1B  possessing\u001b[1Cthat\u001b[1Cmany\u001b[1Cbyte-identical\u001b[1Cfiles\u001b[1Cbelonging\u001b[1Cto\u001b[1Csomeone\u001b[1Celse\u001b[1Cis\u001b[1Cvanishingly\u001b[1Csmall.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.649, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.958, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.923, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  A nice shape: \u001b[38;2;87;105;247m\u001b[1mmax(3, 20% of their receipts)\u001b[22m\u001b[39m. Fixed floor so new-ish accounts aren't trivially recoverable;            \r\u001b[1B  proportional\u001b[1Cfloor\u001b[1Cso\u001b[1Ca\u001b[1C500-receipt\u001b[1Cpower\u001b[1Cuser\u001b[1Cneeds\u001b[1Cto\u001b[1Cprove\u001b[1Cmore.\u001b[1CDon't\u001b[1Cadvertise\u001b[1Cthe\u001b[1Cexact\u001b[1Cthreshold\u001b[1C—\u001b[1Can\u001b[1Cattacker\r\u001b[1B  with access to some of your images should not be able to compute \"do I have enough?\"                                  \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────"]
[0.000, "o", "────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.037, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.139, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mThe attack surfaces worth minding\u001b[22m                                                                                     \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.821, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.963, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.964, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.313, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  1. \u001b[1mProbing for existence.\u001b[22m A recovery endpoint that hashes uploaded files and tells you \"match / no match\" is an       \r\u001b[1B  oracle:\u001b[1C\"does\u001b[1Cthis\u001b[1Cimage\u001b[1Cbelong\u001b[1Cto\u001b[1Cany\u001b[1Caccount\u001b[1Cin\u001b[1Cthe\u001b[1Csystem?\"\u001b[1CSomeone\u001b[1Cwho\u001b[1Ccomes\u001b[1Cinto\u001b[1Cpossession\u001b[1Cof\u001b[1Creceipt\u001b[1Cimages\r\u001b[1B  could learn whether their owner uses your app. Mitigations: only respond with pass/fail after the full batch is       \r\u001b[2C\u001b[1Bprocessed, rate-limit\u001b[1Chard\u001b[1C(N\u001b[1Cattempts\u001b[1Cper\u001b[1Chour\u001b[1Cper\u001b[1CIP),\u001b[1Crequire\u001b[1Ca\u001b[1CCAPTCHA\u001b[1Cor\u001b[1Csimilar\u001b[1Cbefore\u001b[1Caccepting\u001b[1Crecovery\r\r\n\u001b[2Cbatches.\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b"]
[0.000, "o", "[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.652, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.867, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A2.\u001b[1C\u001b[1mEnumeration against a specific target.\u001b[1C\u001b[22mIf\u001b[1Cthe\u001b[1Cattacker\u001b[1Cknows\u001b[1Cthe\u001b[1Ctarget\u001b[1Cuser\u001b[1Cand\u001b[1Chas\u001b[1C\u001b[3msome\u001b[1C\u001b[23mof\u001b[1Ctheir\u001b[1Creceipts\u001b[1C(say\r\u001b[1B  they share a household), they want to know whether they have enough to cross the threshold. Don't return partial match\r\u001b[1B   counts.\u001b[1CRecovery\u001b[1Cis\u001b[1Ca\u001b[1Csingle\u001b[1Cbinary\u001b[1Coutcome:\u001b[1C\"recovery\u001b[1Csucceeded\"\u001b[1Cor\u001b[1C\"could\u001b[1Cnot\u001b[1Cverify.\"\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;"]
[0.000, "o", "2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
