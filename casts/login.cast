[0.000, "o", "\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 280 +\u001b[38;2;51;51;51m| POST   | `/api/auth/register/options`  | —    | Server generates `user_handle` + challenge, returns creation opt\u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mions   |                                                                                                          \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 281 +\u001b[38;2;51;51;51m| POST   | `/api/auth/register/verify`   | —    | Verify attestation, insert user + credential, attach session to \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51muser   |                                                                                                          \u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 282 +\u001b[38;2;51;51;51m| POST   | `/api/auth/login/options`     | —    | Server issues challenge with `allowCredentials: []` (discoverabl\u001b[49m\u001b[39m\r\r\n\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51me)     |                         "]
