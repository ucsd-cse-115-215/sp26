[0.410, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5A\u001b[36mname\u001b[39m:\u001b[1C\u001b[36mstring\u001b[39m,\u001b[8C\u001b[32m// shown by the authenticator, e.g. in the keychain list\r\u001b[1B\u001b[39m                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                                                                                                                     \r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────"]
