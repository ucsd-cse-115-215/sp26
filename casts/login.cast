[0.038, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[7A\u001b[38;2;0;0;0m⏺\u001b[1C\u001b[39mOne detail I want to\u001b[1Cflag before I start: the usernameless\u001b[1Cflow\u001b[1Chas\u001b[1Ca\u001b[1Csmall\u001b[1Cwrinkle.\u001b[1CAt\u001b[1C\u001b[38;2;87;105;247m/register/options\u001b[1C\u001b[39mthe\u001b[1Cserver\r\u001b[1B  mints \u001b[38;2;87;105;247muser_handle\u001b[39m + \u001b[38;2;87;105;247mdisplay_name\u001b[39m, but the attestation returned at \u001b[38;2;87;105;247m/register/verify\u001b[39m doesn't\u001b[1Cecho\u001b[1Cthose\u001b[1Cback.\u001b[1CWe\u001b[1Cneed\u001b[1Cto\r\u001b[3C\u001b[1Bremember\u001b[1Cthem\u001b[1Cserver-side\u001b[1Cbetween\u001b[1Cthe\u001b[1Ctwo\u001b[1Ccalls.\r\u001b[1B                                                                                                                        \r\u001b[1B  Two\u001b[1Creasonable\u001b[1Coptions:\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────"]
