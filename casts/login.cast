[0.769, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[38;2;87;105;247mexpires_at\u001b[39m lets a cron/startup sweep delete stale rows.                                                               \r\u001b[1B   \r\u001b[1B  \u001b[1mReceipt ownership\u001b[22m                                                                                                     \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────"]
