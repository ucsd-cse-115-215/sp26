[0.282, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mOn 2:\u001b[22m Yes — UI calls \u001b[38;2;87;105;247mPOST /api/categories\u001b[39m first, then \u001b[38;2;87;105;247mPUT /api/receipts/:id\u001b[39m with the new category string. Two         \r\u001b[1B  requests,\u001b[1Cbut\u001b[1Cthe\u001b[1Csecond\u001b[1Conly\u001b[1Cfires\u001b[1Cafter\u001b[1Cthe\u001b[1Cfirst\u001b[1Csucceeds\u001b[1Cso\u001b[1Cthe\u001b[1Ccategory\u001b[1Calways\u001b[1Cexists\u001b[1Cbefore\u001b[1Can\u001b[1Citem\u001b[1Creferences\r\u001b[1B  it. If you want atomicity, the item PUT could accept \u001b[38;2;87;105;247m{category, createIfMissing: true}\u001b[39m and do both server-side in one \r\u001b[2C\u001b[1Btransaction.\u001b[1CI'd\u001b[1Cstart\u001b[1Cwith\u001b[1Ctwo\u001b[1Ccalls\u001b[1C—\u001b[1Csimpler,\u001b[1Cand\u001b[1Cthe\u001b[1Cwindow\u001b[1Cwhere\u001b[1Cthe\u001b[1Ccategory\u001b[1Cexists\u001b[1Cwithout an item is harmless.\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────"]
