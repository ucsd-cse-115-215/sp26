[0.261, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mBuffer ↔ Uint8Array\u001b[1C\u001b[22mat\u001b[1Cthe\u001b[1CDB/library\u001b[1Cboundary:\u001b[1C\u001b[38;2;87;105;247mBuffer.from(u8)\u001b[1C\u001b[39mbefore\u001b[1CDB\u001b[1Cwrites,\u001b[1Cpass\u001b[1CBuffers\u001b[1Cstraight\u001b[1Cinto\u001b[1Cthe\r\u001b[1B  library (Buffer is a Uint8Array subclass).                                                                            \r\u001b[1B   \r\u001b[1B  \u001b[1mTests\u001b[22m                                                                                                                 \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────"]
