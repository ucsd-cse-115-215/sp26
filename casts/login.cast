[0.704, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  For your \"minimal info\" goal, the cleanest middle ground is: \u001b[1mno fields at signup, but at first login after \u001b[22m           \r\u001b[1B  \u001b[1mregistration, let the user optionally rename their account.\u001b[1C\u001b[22mThat\u001b[1Crename\u001b[1Cupdates\u001b[1Cthe\u001b[1C\u001b[38;2;87;105;247mdisplayName\u001b[1C\u001b[39min\u001b[1Cthe\u001b[1C\u001b[38;2;87;105;247musers\u001b[1C\u001b[39mtable,\r\u001b[1B  and you re-register next time they add a device with the friendlier label. Until then, the server-generated label is  \r\u001b[2C\u001b[1Bfine.       \r\r\n\r\r\n\u001b[2C\u001b[1mSchema\u001b[1Cimplication\u001b[22m\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.218, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  If you commit to fully usernameless, the \u001b[38;2;87;105;247musers\u001b[39m table simplifies:                                                      \r\u001b[1B   \r\u001b[1B  \u001b[34mCREATE\u001b[39m \u001b[34mTABLE\u001b[39m users (                                                                                                  \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "──────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.039, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.347, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5Aid\u001b[11C\u001b[36m\u001b[2mINTEGER\u001b[1C\u001b[22m\u001b[34mPRIMARY\u001b[1C\u001b[39mKEY\u001b[1CAUTOINCREMENT,\r\u001b[1B    user_handle  \u001b[36m\u001b[2mBLOB\u001b[22m\u001b[39m \u001b[34mNOT\u001b[39m \u001b[34mNULL\u001b[39m \u001b[34mUNIQUE\u001b[39m,                                                                                  \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.413, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5Adisplay_name\u001b[1CTEXT,\u001b[2C\u001b[32m-- optional label, for authenticator UI only\r\u001b[1B\u001b[39m                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m                                                                                                                     \r\u001b[1B\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.205, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.209, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5Acreated_at\u001b[3CTEXT\u001b[1C\u001b[34mNOT\u001b[1CNULL\u001b[1CDEFAULT\u001b[1C\u001b[39m(datetime(\u001b[31m'now'\u001b[39m))\r\u001b[1B  );                                                                                                                    \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.757, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.371, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  No \u001b[38;2;87;105;247musername\u001b[39m column, no uniqueness constraint on human-chosen strings, no \"username already taken\" error state. Logins \r\u001b[1B  do\u001b[1C\u001b[38;2;87;105;247mSELECT id FROM users WHERE user_handle = ?\u001b[1C\u001b[39musing\u001b[1Cthe\u001b[1Cbytes\u001b[1Creturned\u001b[1Cby\u001b[1Cthe\u001b[1Cauthenticator.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────"]
[0.000, "o", "───────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.334, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mThe real cost you're accepting\u001b[22m                                                                                        \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.259, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.963, "o", "\u001b]0;⠐ Implement passkey authentication system\u0007"]
[0.798, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Usernameless + no email = \u001b[1mno account recovery, ever.\u001b[22m If the user loses all devices holding their passkeys and their   \r\u001b[1B  sync\u001b[1Cprovider\u001b[1Ccan't\u001b[1Crestore\u001b[1C(forgot\u001b[1CiCloud\u001b[1Cpassword,\u001b[1Cetc.),\u001b[1Cthe\u001b[1Caccount\u001b[1Cis\u001b[1Cgone.\u001b[1CYou\u001b[1Ccan't\u001b[1Cemail\u001b[1Cthem\u001b[1Ca\u001b[1Creset\u001b[1Clink\u001b[1C—\r\u001b[1B  there's no email. You can't ask security questions — there's nothing stored.                                          \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
[0.161, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
