[0.484, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[38;2;87;105;247m\u001b[1mlast_used_at\u001b[1C\u001b[22m\u001b[39m—\u001b[1Cpurely\u001b[1Cfor\u001b[1Cthe\u001b[1C\"manage\u001b[1Cmy\u001b[1Cpasskeys\"\u001b[1CUI.\u001b[1CSkip\u001b[1Cit\u001b[1Cif\u001b[1Cyou\u001b[1Cdon't\u001b[1Cwant\u001b[1Ca\u001b[1Csettings\u001b[1Cpage\u001b[1Cyet.\r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;87;105;247m\u001b[1msessions\r\u001b[1B\u001b[22m\u001b[39m                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m──────────────────"]
