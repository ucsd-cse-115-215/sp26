[0.865, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mFailed verify.\u001b[1C\u001b[22mIf\u001b[1Cthe\u001b[1Csignature\u001b[1Cdoesn't\u001b[1Cvalidate\u001b[1Cor\u001b[1Cthe\u001b[1Cchallenge\u001b[1Cdoesn't\u001b[1Cmatch,\u001b[1Cthe\u001b[1Chandler\u001b[1Creturns\u001b[1Can\u001b[1Cerror\r\u001b[1B  without calling \u001b[38;2;87;105;247mattachSessionUser\u001b[39m. The pre-auth session remains; user can retry.                                      \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
