[0.580, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Don't store the challenge in a DB at all. Sign it into a short-lived JWT or equivalent and hand it back to the client;\r\u001b[1B   client\u001b[1Cechoes\u001b[1Cit\u001b[1Cat\u001b[1Cverify.\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────────"]
