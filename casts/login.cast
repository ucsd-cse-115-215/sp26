[0.893, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Same shape as #1, but with two different cookies: \u001b[38;2;87;105;247mceremony=abc...\u001b[39m for pending, \u001b[38;2;87;105;247msid=xyz...\u001b[39m for authenticated. Server   \r\u001b[1B  reads\u001b[1Cwhichever\u001b[1Cis\u001b[1Cpresent\u001b[1Cand\u001b[1Croutes\u001b[1Caccordingly.\u001b[1CThe\u001b[1Chandoff\u001b[1Cat\u001b[1Cverify\u001b[1Cis\u001b[1C\"set\u001b[1Csid,\u001b[1Cclear\u001b[1Cceremony.\"\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────"]
