[0.729, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  The library checks both. \u001b[38;2;87;105;247mrpID\u001b[39m is about credential binding; \u001b[38;2;87;105;247mexpectedOrigin\u001b[39m is anti-phishing for this particular        \r\u001b[1B  ceremony.\u001b[1CIn\u001b[1Cprod\u001b[1Cyou'll\u001b[1Cpass\u001b[1Cthe\u001b[1Creal\u001b[1Corigin;\u001b[1Cin\u001b[1Cdev,\u001b[1C\u001b[38;2;87;105;247m\"http://localhost:5173\"\u001b[1C\u001b[39m(Vite)\u001b[1Cand\u001b[1C\u001b[38;2;87;105;247mrpID: \"localhost\"\u001b[39m.\r\u001b[1B                                                                                                                        \r\u001b[2C\u001b[1B\u001b[1mConcrete recommendation\u001b[22m\r\r\n\r\r\n\u001b[2CFor\u001b[1Cthis\u001b[1Cproject:\r\r\n\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[3"]
