[0.707, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5A-\u001b[1CYour\u001b[1Cstored\u001b[1Cset\u001b[1Cwill\u001b[1Clikely\u001b[1Cend\u001b[1Cup\u001b[1Cas\u001b[1C\u001b[38;2;87;105;247m{internal, hybrid}\u001b[1C\u001b[39m—\u001b[1Ca\u001b[1Cunion\u001b[1Cover\u001b[1Cwhat\u001b[1Cthe\u001b[1Cbrowser\u001b[1Chas\u001b[1Creported,\u001b[1Cnot\u001b[1Ca\r\u001b[1B  description of either authenticator alone.                                                                            \r\u001b[1B  -\u001b[1C\u001b[1m1Password as a software authenticator holding a credential.\r\u001b[1B\u001b[22m                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────"]
