[0.634, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A2.\u001b[1C\u001b[38;2;87;105;247m\u001b[1mlogin/verify\u001b[39m relies on discoverable credentials.\u001b[1C\u001b[22mIt\u001b[1Creads\u001b[1C\u001b[38;2;87;105;247mreq.body.response.userHandle\u001b[1C\u001b[39m(not\u001b[1Cprovided\u001b[1Cby\u001b[1Cthe\u001b[1Cclient\r\u001b[1B  — the authenticator signs and emits it based on what was stored at registration) and uses it to find the user row. If \r\u001b[1B  \u001b[38;2;87;105;247muserHandle\u001b[1C\u001b[39mis\u001b[1Cabsent,\u001b[1Cthe\u001b[1Ccredential\u001b[1Cwasn't\u001b[1Cdiscoverable\u001b[1Cand\u001b[1Cwe\u001b[1Cerror\u001b[1Cout.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯"]
