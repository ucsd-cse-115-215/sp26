[0.961, "o", "\u001b]0;⠂ Implement passkey authentication system\u0007"]
[0.901, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A3.\u001b[1C\u001b[1mShared households.\u001b[1C\u001b[22mThis\u001b[1Cis\u001b[1Cthe\u001b[1Creal\u001b[1Cedge\u001b[1Ccase.\u001b[1CIf\u001b[1Ctwo\u001b[1Cpeople\u001b[1Cboth\u001b[1Cuse\u001b[1Cyour\u001b[1Capp\u001b[1Cand\u001b[1Cone\u001b[1Cuploads\u001b[1Ca\u001b[1Cgrocery\u001b[1Creceipt\r\u001b[1B  that the other also has a photo of, they could \"recover\" each other's accounts. Partial mitigation: require that the  \r\u001b[1B  matching\u001b[1Cimages\u001b[1Call\u001b[1Cbelong\u001b[1Cto\u001b[1C\u001b[3mone\u001b[1C\u001b[23maccount,\u001b[1Cnot\u001b[1Cmultiple.\u001b[1CIf\u001b[1Cthe\u001b[1Cuploaded\u001b[1Cbatch\u001b[1Cmatches\u001b[1Cagainst\u001b[1Ctwo\u001b[1Caccounts,\u001b[1Crefuse\r\u001b[1B  recovery and show \"could not verify\" rather than picking one.                                                         \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "───────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
