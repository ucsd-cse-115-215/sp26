[0.166, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  1. \u001b[38;2;87;105;247m\u001b[1mregister/options\u001b[39m generates \u001b[38;2;87;105;247muser_handle\u001b[39m and \u001b[38;2;87;105;247mdisplay_name\u001b[39m server-side\u001b[22m and stashes them on the session. They're       \r\u001b[1B  consumed\u001b[1Cat\u001b[1C\u001b[38;2;87;105;247mregister/verify\u001b[1C\u001b[39mand\u001b[1Chanded\u001b[1Cinto\u001b[1C\u001b[38;2;87;105;247minsertUser\u001b[1C\u001b[39mthere\u001b[1C—\u001b[1Cthe\u001b[1Cuser\u001b[1Crow\u001b[1Cdoesn't\u001b[1Cexist\u001b[1Cuntil\u001b[1Cverify\u001b[1Csucceeds.\u001b[1CIf\r\u001b[1B  verify never happens, the pre-auth session expires in 5 min and the pending data goes with it.                        \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2"]
