[0.434, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[13A-\u001b[1CSchema:\u001b[1C\u001b[38;2;87;105;247mcategories(name TEXT PRIMARY KEY, active INTEGER DEFAULT 1)\u001b[1C\u001b[39mseeded\u001b[1Cwith\u001b[1Cthe\u001b[1Ccurrent\u001b[1C9\u001b[1Cnames\u001b[1Con\u001b[1Cfirst\u001b[1Cboot.\r\u001b[4C\u001b[1BPros: explicit — users (or an API) can add/rename/deactivate. Prompt r\u001b[1Cads\u001b[1C\u001b[38;2;87;105;247mWHERE active=1\u001b[39m. Clear audit\u001b[1Ctrail.     \r\u001b[2C\u001b[1BRenames\u001b[1Ccan cascade to \u001b[38;2;87;105;247mreceipt_items\u001b[1C\u001b[39min a transaction.         \u001b[1C      \u001b[1C     \u001b[1C               \u001b[1C     \u001b[1C     \u001b[1C      \r\u001b[2C\u001b[1B- Cons:\u001b[1Cnow\u001b[1Cthere are two places category\u001b[1Cdata lives —\u001b[1Cthe\u001b[1Ctable\u001b[1Cand\u001b[1Cthe\u001b[1Citem\u001b[1Crows\u001b[1C—\u001b[1Cand\u001b[1Cthey\u001b[1Ccan\u001b[1Cdrift\u001b[1C(item\u001b[1Chas\u001b[1Ca\r\u001b[2C\u001b[1Bcategory string th\u001b[1Ct isn't in the table).\u001b[1CNeed\u001b[1Ca policy: FK-enforce,\u001b[1Cor just document tha\u001b[1C the table is\u001b[1Cthe  \u001b[1C   \u001b[1C \r\u001b[2C\u001b[1B\"sug\u001b[1Cestion set\" and\u001b[2Ctems\u001b[1Ccan \u001b[1Cold anything. \u001b[1C \u001b[1C       \u001b[1C           \u001b[1C  \u001b[1C    \u001b[1C        \u001b[1C    \u001b[1C   \u001b[1C     \u001b[1C  \u001b[1C   \r\u001b[2C\u001b[1B- Also"]
