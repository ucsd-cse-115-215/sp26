[0.127, "o", "\u001b[2A4.\u001b[C\u001b[1mThe \u001b[38;5;105mparseReceiptBuffer\u001b[39m refactor\u001b[C\u001b(B\u001b[m\u2014\u001b[Cthat\u001b[C\u001b[38;5;105mparseReceipt\u001b[C\u001b[39mis\u001b[Cnow\u001b[Ca\u001b[Cthin\u001b[Cwrapper\u001b[Caround\u001b[C\u001b[38;5;105mparseReceiptBuffer\u001b[39m,\u001b[Cand\u001b[Cthe\u001b[Cserver\u001b[Cuses\u001b[Cthe\r\n  buffer version with multer's memory storage. This affects how you'd add new parsing features.                                     \u001b[33;1H   \u001b[35;1H\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[7m \u001b(B\u001b[m           \r\n\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[36;1H\u001b[2S\u001b[35;2H\u001b[1K\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241mINSERT\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[K\r\n\u001b[K\u001b[33;3H"]
