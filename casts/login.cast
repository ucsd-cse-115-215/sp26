[0.502, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[38;2;87;105;247msrc/server/session.ts\u001b[39m — cookie options (\u001b[38;2;87;105;247mHttpOnly\u001b[39m, \u001b[38;2;87;105;247mSameSite=Lax\u001b[39m, \u001b[38;2;87;105;247mSecure\u001b[39m gated on \u001b[38;2;87;105;247mNODE_ENV\u001b[39m, 30-day \u001b[38;2;87;105;247mMax-Age\u001b[39m),          \r\u001b[1B  \u001b[38;2;87;105;247msetSessionCookie\u001b[1C\u001b[39m/\u001b[1C\u001b[38;2;87;105;247mclearSessionCookie\u001b[39m,\u001b[1Cand\u001b[1Cthree\u001b[1Cmiddlewares:\u001b[1C\u001b[38;2;87;105;247msessionMiddleware(db)\u001b[1C\u001b[39m(reads\u001b[1Ccookie\u001b[1C→\u001b[1Cpopulates\r\u001b[1B  \u001b[38;2;87;105;247mreq.session\u001b[39m / \u001b[38;2;87;105;247mreq.user\u001b[39m), \u001b[38;2;87;105;247mensureSession(db)\u001b[39m (creates a pre-auth session on demand for the auth-options endpoints),     \r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mrequireAuth\u001b[39m (401s\u001b[1Con\u001b[1Cno\u001b[1Cuser).\u001b[1CConstants:\u001b[1C\u001b[38;2;87;105;247mPRE_AUTH_TTL_SECONDS = 300\u001b[39m,\u001b[1C\u001b[38;2;87;105;247mPOST_AUTH_TTL_SECONDS = 30d\u001b[39m.\r\r\n\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────"]
