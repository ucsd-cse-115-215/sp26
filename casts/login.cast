[0.120, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  \u001b[1mMigration for existing DBs.\u001b[22m \u001b[38;2;87;105;247mCREATE TABLE IF NOT EXISTS\u001b[39m won't backfill the new \u001b[38;2;87;105;247muser_id\u001b[39m column on an existing \u001b[38;2;87;105;247mreceipts\u001b[39m  \r\u001b[1B  table.\u001b[1CUse\u001b[1C\u001b[38;2;87;105;247mPRAGMA user_version\u001b[1C\u001b[39mto\u001b[1Cgate:\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────"]
