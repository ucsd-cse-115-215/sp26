[0.067, "o", "\u001b[32;1H  1. \u001b[1mImport directly from the server files\u001b(B\u001b[m \u2014 \u001b[38;5;105mimport type { StoredReceipt } from \"../../src/server/db.ts\"\u001b[39m. Simple, no new files. But \u001b[33;1H  the\u001b[Cpath\u001b[Cis\u001b[Ca\u001b[Cbit\u001b[Cugly\u001b[Ccrossing\u001b[Cfrom\u001b[C\u001b[38;5;105mclient/\u001b[C\u001b[39mback\u001b[Cinto\u001b[C\u001b[38;5;105msrc/\u001b[39m.\r\n                                                                                                                                    \u001b[35;1H\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[36;1H\u001b(B\u001b[m\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[36;132H\n\u001b[35;3H\u001b[7m \u001b(B\u001b[m\r\n\u001b[K\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
