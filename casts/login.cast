[0.036, "o", "\u001b[?2026h\u001b[55D\u001b[3B\r\u001b[4A  The thing that makes A unusually viable for a passkey-native app: \u001b[1mcreating a second account is essentially free.\u001b[22m No   \r\u001b[1B  passwo\u001b[1Cd\u001b[1Cto pick, no email to type, no\u001b[1Cverifica\u001b[1Cion\u001b[1Cemail\u001b[1Cto\u001b[1Cwait\u001b[1Cfor.\u001b[1CIt's\u001b[1Cone\u001b[1Cclick\u001b[1C+\u001b[1CTouch\u001b[1CID.\u001b[1CSo\u001b[1C\"I\u001b[1Cwant\u001b[1Ca\r\u001b[1B  separate receipt set for my business\" doesn't need product support — the auth flow already supports it trivially.     \r\u001b[2C\u001b[1BYou're not taxing\u001b[1Cthe\u001b[1Cuser\u001b[1Cby\u001b[1Cmaking\u001b[1Cthem\u001b[1Csign\u001b[1Cup\u001b[1Ctwice;\u001b[1Cyou're\u001b[1Ctaking\u001b[1Cadvantage\u001b[1Cof\u001b[1Cthe\u001b[1Cfact\u001b[1Cthat\u001b[1Cpasskey\u001b[1Csignup\u001b[1Cis\r\r\n\u001b[2Cnearly\u001b[1Cinstant.\r\r\n\r\r\n\u001b[38;2;153;153;153m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
[0.000, "o", "─────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39mRecovery\u001b[1Cisn't\u001b[1Cimpossible\u001b[1Cin\u001b[1Cthis\u001b[1Capp,\u001b[1Cbtw.\u001b[1CIf\u001b[1Cthey\u001b[1Cu\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[39m\r\r\n\u001b[55C\u001b[3A\u001b[?2026l"]
