[0.402, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  - \u001b[38;2;87;105;247m\u001b[1mcredential_id\u001b[22m\u001b[39m — opaque bytes the authenticator generates. This is what the server sends back in \u001b[38;2;87;105;247mallowCredentials\u001b[39m to \r\u001b[1B  say\u001b[1C\"hey\u001b[1Cbrowser,\u001b[1Chere\u001b[1Care\u001b[1Cthe\u001b[1Cpasskeys\u001b[1CI\u001b[1Cknow\u001b[1Cabout\u001b[1Cfor\u001b[1Cthis\u001b[1Cuser,\u001b[1Cask\u001b[1Cthe\u001b[1Cauthenticator\u001b[1Cif\u001b[1Cit\u001b[1Chas\u001b[1Cany\u001b[1Cof\u001b[1Cthem.\"\r\u001b[1B  Typically 16–1023 bytes; usually ~32–64. Stored as BLOB (base64url in your JSON API, raw bytes in the DB).            \r\u001b[2C\u001b[1B            \u001b[83C                     \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────"]
[0.000, "o", "───────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;102;102;102m--\u001b[1CINSERT\u001b[1C--\u001b[83CNow\u001b[1Cusing\u001b[1Cextra\u001b[1Cusage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
