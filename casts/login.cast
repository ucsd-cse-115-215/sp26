[0.571, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[8A-\u001b[1CState\u001b[1Cis\u001b[1Cstructurally\u001b[1Cimpossible\u001b[1Cto\u001b[1Cget\u001b[1Cwrong.\u001b[1CThere's\u001b[1Cno\u001b[1C\"session\u001b[1Cwith\u001b[1Ca\u001b[1CNULL\u001b[1Cuser\"\u001b[1Cshape.\r\u001b[4C\u001b[1BEach table gets the TTL, indexing, and prune cadenc\u001b[1C appropriate to \u001b[2Cs\u001b[2Cctual\u001b[1Crole.\u001b[1C      \r\u001b[4C\u001b[1B\u001b[38;2;87;105;247msessions\u001b[39m gets a\u001b[1C\u001b[38;2;87;105;247mNOT NULL user_id\u001b[39m FK — schema-lev\u001b[1Cl gu\u001b[1Crantee that every\u001b[1Csession is authenticated.\r\u001b[2B  Cons:                                                                                                                 \r\u001b[1B   \r\u001b[2B\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m           \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C"]
