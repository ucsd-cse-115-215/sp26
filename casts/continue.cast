[31.049, "o", "\u001b[?2026h\u001b[2;40r\u001b[2;40r\u001b[62;120s\u001b[39S\u001b[1;62H\u001b[K\u001b[2;40r\u001b[s\u001b[1;62H\u001b[38;5;130m 49 \u001b[2;62H 50 \u001b[39mNot every image is a valid receipt. The function will t\u001b[3;62H\u001b[38;5;130m    \u001b[39mhrow on:\u001b[4;62H\u001b[38;5;130m 51 -\u001b[39m Non-receipt images (Claude indicates it can't extract\u001b[5;62H\u001b[38;5;130m    \u001b[39m receipt data)\u001b[6;62H\u001b[38;5;130m 52 -\u001b[39m API errors (rate limits, network issues)\u001b[7;62H\u001b[38;5;130m 53 \u001b[8;62H 54 \u001b[39mWe won't try to silently return partial data   \u001b[8;111H\u2014\u001b[8;114Hbetter \u001b[9;62H\u001b[38;5;130m    \u001b[39mto surface failures clearly at this stage.\u001b[10;62H\u001b[38;5;130m 55 \u001b[11;62H 56 \u001b(B\u001b[m\u001b[35m## Files\u001b[12;62H\u001b[38;5;130m 57 \u001b[13;62H 58 \u001b(B\u001b[m\u001b[35m```\u001b[14;62H\u001b[38;5;130m 59 \u001b[39msrc/\u001b[15;62H\u001b[38;5;130m 60 \u001b[39m  types.ts\u001b[15;86H  \u001b[15;86H\u2014\u001b[15;89HReceiptItem and ParsedReceipt ty\u001b[16;62H\u001b[38;5;130m    \u001b[39mpes\u001b[17;62H\u001b[38;5;130m 61 \u001b[39m  parseReceipt.ts     \u001b[17;86H\u2014\u001b[17;89HCore function: image path   \u001b[17;115H\u2192\u001b[17;118HPar\u001b[18;62H\u001b[38;5;130m    \u001b[39msedReceipt\u001b[19;62H\u001b[38;5;130m 62 \u001b[39m  cli.ts\u001b[19;86H"]
[0.0, "o", "  \u001b[19;86H\u2014\u001b[19;89HTiny entry point: `npx tsx src/c\u001b[20;62H\u001b[38;5;130m    \u001b[39mli.ts receipt.jpg`\u0007\u001b[1;40r\u001b[21;62H\u001b[?25l\u001b[?2026l\u001b[38;5;130m 63 \u001b[39m.env\u001b[21;86H  \u001b[21;86H\u2014\u001b[21;89HANTHROPIC_API_KEY (gitignored)\u001b[22;62H\u001b[38;5;130m 64 \u001b(B\u001b[m\u001b[35m```\u001b[23;62H\u001b[38;5;130m 65 \u001b[24;62H 66 \u001b(B\u001b[m\u001b[35m## Dependencies\u001b[25;62H\u001b[38;5;130m 67 \u001b[26;62H 68 -\u001b[39m \u001b[35m`\u001b[39m@anthropic-ai/sdk\u001b[35m`\u001b[39m   \u001b[26;88H\u2014\u001b[26;91HAnthropic's official TypeScrip\u001b[27;62H\u001b[38;5;130m    \u001b[39mt SDK\u001b[28;62H\u001b[38;5;130m 69 -\u001b[39m \u001b[35m`\u001b[39mtsx\u001b[35m`\u001b[39m (dev)   \u001b[28;80H\u2014\u001b[28;83Hruns TypeScript directly without a bui\u001b[29;62H\u001b[38;5;130m    \u001b[39mld step\u001b[30;62H\u001b[38;5;130m 70 \u001b[31;62H 71 \u001b[39mThat's it. We don't need dotenv because the SDK reads \u001b[35m`\u001b[32;62H\u001b[38;5;130m    \u001b[39mANTHROPIC_API_KEY\u001b[35m`\u001b[39m from the environment automatically. \u001b[33;62H\u001b[38;5;130m    \u001b[39mWe keep the dependency footprint minimal.\u001b[34;62H\u001b[38;5;130m 72 \u001b[35;62H 73 \u001b(B\u001b[m\u001b[35m## Testing it\u001b[36;62H\u001b[38;5;130m 74 \u001b[37;62H 75 \u001b[39mOnce built, you can run:\u001b[38;62"]
