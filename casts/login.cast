[0.214, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  One-time, idempotent, survives across dev restarts. Nullable FK means existing rows just stay with \u001b[38;2;87;105;247muser_id = NULL\u001b[39m — no\r\u001b[1B   data\u001b[1Closs,\u001b[1Cno\u001b[1Cdecision\u001b[1Crequired\u001b[1Cyet.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m─────────────────────────────────────────────────────────────────────────"]
