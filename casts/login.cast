[0.872, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[1C\u001b[1mSomeone poking at cookies.\u001b[1C\u001b[22mIf\u001b[1Can\u001b[1Cattacker\u001b[1Cmanually\u001b[1Ccrafts\u001b[1Ca\u001b[1C\u001b[38;2;87;105;247msid=whatever\u001b[1C\u001b[39mcookie\u001b[1Cand\u001b[1Chits\u001b[1C/api/receipts,\u001b[1C\u001b[38;2;87;105;247mgetSession\r\u001b[1B\u001b[39m  returns null (no matching row), \u001b[38;2;87;105;247mreq.session\u001b[39m and \u001b[38;2;87;105;247mreq.user\u001b[39m stay unset, \u001b[38;2;87;105;247mrequireAuth\u001b[39m 401s. Never reaches a \u001b[38;2;87;105;247muser_id IS NULL\r\u001b[1B\u001b[39m   state\u001b[1Cvia\u001b[1Cthat\u001b[1Cpath.\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102"]
