[0.049, "o", "\u001b[3AThe\u001b[Cmain\u001b[Cwiring\u001b[Cissue\u001b[Cis\u001b[Cthat\u001b[C\u001b[38;5;105mnode:test\u001b[C\u001b[39mdoesn't\u001b[Cknow\u001b[Cabout\u001b[CTypeScript.\u001b[CYou'd\u001b[Crun\u001b[Cit\u001b[Cthrough\u001b[C\u001b[38;5;105mtsx\u001b[C\u001b[39mlike:\u001b[32;1H  npx tsx --\u001b[36mtest\u001b[39m \u001b[36mtest\u001b[39m/api.test.ts                                                                                                   \u001b[33;1H   \u001b[35;1H\u001b[38;5;241m\u276f\u00a0\u001b[39m\u001b[7m \u001b(B\u001b[m           \r\n\u001b[38;5;246m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[36;1H\u001b[2S\u001b[35;2H\u001b[1K\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241mINSERT\u001b[39m\u001b[1X\u001b[C\u001b[38;5;241m--\u001b[39m\u001b[K\r\n\u001b[K\u001b[33;3H"]
