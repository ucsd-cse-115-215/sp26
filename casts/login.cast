[0.765, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4C\u001b[5A\u001b[34mCHECK\u001b[1C\u001b[39m(\u001b[1C(state\u001b[1C=\u001b[1C\u001b[31m'pending'\u001b[7C\u001b[34mAND\u001b[1C\u001b[39muser_id\u001b[1C\u001b[34mIS\u001b[1CNULL\u001b[1CAND\u001b[1C\u001b[39mchallenge\u001b[1C\u001b[34mIS\u001b[1CNOT\u001b[1CNULL\u001b[39m)\r\u001b[1B         \u001b[34mOR\u001b[39m (state = \u001b[31m'authenticated'\u001b[39m \u001b[34mAND\u001b[39m user_id \u001b[34mIS\u001b[39m \u001b[34mNOT\u001b[39m \u001b[34mNULL\u001b[39m) )                                                         \r\u001b[1B  );\r\u001b[1B                                                                                                                        \r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m───────────────────────"]
