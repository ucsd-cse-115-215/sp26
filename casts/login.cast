[0.310, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[4A  Here's the sequence for registration (login is identical in shape):                                                   \r\u001b[1B   \r\u001b[1B  1. Browser →  POST /api/auth/register/options                                                                         \r\u001b[2C\u001b[1B            \r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;2;102;102;102m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\n\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────"]
